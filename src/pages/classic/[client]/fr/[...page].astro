---
import { getClients } from '../../../../lib/clients';
import { frenchSlug } from '../../../../lib/i18n';
import { classicPages, type ClassicPage } from '../../../../lib/view';
import Classic from '../../../../templates/Classic.astro';
import type { Client } from '../../../../schemas/client';

/**
 * The French Classic site, for clients with `translations.fr`: /classic/<client>/fr/ is Accueil, and
 * each other page is a French-named folder under it (/fr/a-propos/, /fr/enseignement/…). Book pages
 * stay English only.
 */
export function getStaticPaths() {
  return getClients()
    .filter((client) => client.translations?.fr)
    .flatMap((client) =>
      classicPages
        .filter((page) => page !== 'speaking' || client.speaking)
        .map((page) => ({
          params: { client: client.slug, page: frenchSlug(client, page) || undefined },
          props: { client, page },
        })),
    );
}

const { client, page } = Astro.props as { client: Client; page: ClassicPage };
---

<Classic client={client} page={page} lang="fr" />
