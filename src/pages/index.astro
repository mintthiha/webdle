---
import '@fontsource/spectral/300.css';
import '@fontsource/spectral/300-italic.css';
import '@fontsource/spectral/400.css';
import '@fontsource-variable/public-sans/wght.css';
import '@fontsource-variable/besley/wght.css';
import '../styles/global.css';
import { getClients } from '../lib/clients';
import { directions } from '../lib/view';
import { landscape, collage, overprint, horizon } from '../lib/art';

const clients = getClients();

const art = {
  prestige: landscape({ seed: 'landing-pr', motif: 'teacher', layers: 8, w: 900, h: 600, sunSize: 0.1 }),
  warmth: collage({ seed: 'landing-wm', w: 900, h: 600 }),
  wow: overprint({
    letters: [
      { ch: 'W', advance: 1.02 },
      { ch: 'o', advance: 0.62 },
      { ch: 'w', advance: 0.88 },
    ],
  }),
  calm: horizon({ seed: 'landing-ca', motif: 'writer', w: 900, h: 600 }),
};
const label = { teacher: 'teacher', writer: 'writer' } as const;

/** The headline as separate words, each behind its own baseline, so they can rise in turn. */
const headline = 'When people search your name, they should find <em>you</em>.'
  .split(' ')
  .map((w, i) => `<span class="lp-word" style="--w:${i}"><span>${w}</span></span>`)
  .join(' ');

const services = [
  {
    title: 'Strategy',
    body: 'Work out how you want to be known, who you are speaking to and what the site should do for you.',
  },
  {
    title: 'Design and copy',
    body: 'A site designed and written for your profession, built from facts you provide and approve.',
  },
  {
    title: 'Name-search setup',
    body: 'Clean structure, fast pages and the technical groundwork that helps search engines understand who you are.',
  },
  {
    title: 'Ongoing care',
    body: 'Content updates, maintenance and monitoring of how you appear online.',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f8f9fc" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>webdle · Personal websites for teachers and writers</title>
    <meta
      name="description"
      content="webdle builds personal websites for teachers and writers, so the first thing people find when they search your name is you."
    />
  </head>
  <body>
    <script is:inline>
      // Hold the scroll reveals back until the script arrives; give the page back if it never does.
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('lp-js');
        setTimeout(function () {
          if (!document.querySelector('.lp.is-ready')) document.documentElement.classList.remove('lp-js');
        }, 5000);
      }
    </script>

    <div class="lp">
      <header class="lp-top">
        <a class="lp-mark" href="/">webdle</a>
        <a class="lp-jump" href="#designs">See the designs</a>
      </header>

      <section class="lp-hero">
        <h1 set:html={headline} />
        <p>
          webdle builds personal websites for teachers and writers: a professional home on the web
          that you control, instead of a scatter of profiles and staff pages.
        </p>
        <a class="lp-cta" href="#designs">
          Explore four sample designs
          <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M8 2.5v11M3.5 9 8 13.5 12.5 9" /></svg>
        </a>
      </section>

      <section class="lp-designs" id="designs">
        <div class="lp-head">
          <h2 data-rv="up">One person, four ways to be seen</h2>
          <p data-rv="rise">
            The same sample teacher and writer, designed four ways. Every site is fictional. Open
            one, scroll through it, and use the switcher at the bottom right to compare.
          </p>
        </div>
        <ul class="lp-grid">
          {directions.map((d) => (
            <li class={`lp-tile lp-tile-${d.slug}`} data-rv="tile">
              <div class="lp-art" aria-hidden="true" set:html={art[d.slug]} />
              <div class="lp-body">
                <h3>{d.name}</h3>
                <p class="lp-feel">{d.feeling}</p>
                <p>{d.blurb}</p>
                <div class="lp-links">
                  {clients.map((c) => (
                    <a href={`/${d.slug}/${c.slug}/`}>
                      <span>{c.name} <small>({label[c.archetype]})</small></span>
                      <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M2.5 8h11M9 3.5 13.5 8 9 12.5" /></svg>
                    </a>
                  ))}
                </div>
              </div>
            </li>
          ))}
        </ul>
      </section>

      <section class="lp-services">
        <h2 data-rv="up">What is included</h2>
        <div class="lp-svc">
          {services.map((s) => (
            <div data-rv="row">
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </div>
          ))}
        </div>
        <p class="lp-fine" data-rv="rise">
          Search results depend on many factors outside anyone's control, so we do not promise
          specific rankings or timelines.
        </p>
        <!-- [TODO: webdle contact link or form] -->
      </section>

      <footer class="lp-foot">© {new Date().getFullYear()} webdle</footer>
    </div>
  </body>
</html>

<script>
  import '../scripts/landing';
</script>

<style is:global>
  html {
    background: oklch(0.985 0.004 250);
    scrollbar-color: oklch(0.72 0.02 255) oklch(0.96 0.006 250);
  }
  .lp {
    --ink: oklch(0.22 0.02 255);
    --muted: oklch(0.44 0.02 255);
    --line: oklch(0.88 0.01 255);
    --accent: oklch(0.45 0.09 250);
    --ease: cubic-bezier(0.16, 1, 0.3, 1);
    font-family: 'Public Sans Variable', ui-sans-serif, system-ui, sans-serif;
    color: var(--ink);
    line-height: 1.65;
    font-size: 1.0625rem;
    overflow-x: clip;
  }
  .lp ::selection {
    background: var(--accent);
    color: oklch(0.985 0.004 250);
  }
  .lp h1,
  .lp h2,
  .lp h3 {
    font-family: 'Spectral', Georgia, serif;
    font-weight: 300;
    margin: 0;
    text-wrap: balance;
    letter-spacing: -0.01em;
  }
  .lp a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .lp [tabindex='-1']:focus {
    outline: none;
  }
  .lp a svg {
    flex: none;
    width: 1em;
    height: 1em;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .lp-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 1.75rem clamp(1.25rem, 5vw, 4rem);
  }
  .lp-mark {
    font-family: 'Spectral', serif;
    font-size: 1.5rem;
    color: var(--ink);
    text-decoration: none;
  }
  .lp-jump {
    color: var(--accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
    transition: text-underline-offset 0.4s var(--ease), color 0.3s;
  }
  .lp-jump:hover {
    color: var(--ink);
    text-underline-offset: 8px;
  }
  .lp-hero {
    padding: clamp(4rem, 10vw, 8rem) clamp(1.25rem, 5vw, 4rem) clamp(4rem, 9vw, 7rem);
    max-width: 62rem;
  }
  .lp-hero h1 {
    font-size: clamp(2.6rem, 7vw, 5.25rem);
    line-height: 1.04;
  }
  .lp-word,
  .lp-word > span {
    display: inline-block;
  }
  .lp-hero em {
    color: var(--accent);
  }
  .lp-hero p {
    margin: 1.75rem 0 0;
    max-width: 38rem;
    font-size: clamp(1.15rem, 1.8vw, 1.35rem);
    color: var(--muted);
  }
  .lp-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    margin-top: 2.25rem;
    padding: 0.95rem 1.5rem 0.95rem 1.7rem;
    border-radius: 999px;
    background: var(--ink);
    color: oklch(0.985 0.004 250);
    text-decoration: none;
    font-weight: 600;
    transition: background 0.3s, scale 0.3s var(--ease);
  }
  .lp-cta svg {
    transition: translate 0.5s var(--ease);
  }
  .lp-cta:hover {
    background: var(--accent);
  }
  .lp-cta:hover svg {
    translate: 0 3px;
  }
  .lp-cta:active {
    scale: 0.97;
    transition-duration: 0.1s;
  }
  .lp-designs {
    padding: clamp(3rem, 7vw, 6rem) clamp(1.25rem, 5vw, 4rem);
    border-top: 1px solid var(--line);
  }
  .lp-head {
    max-width: 44rem;
    margin-bottom: 3rem;
  }
  .lp-head h2,
  .lp-services h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.15;
  }
  .lp-head p {
    margin: 1rem 0 0;
    color: var(--muted);
  }
  .lp-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.25rem, 2.5vw, 2rem);
    align-items: start;
  }
  @media (max-width: 52rem) {
    .lp-grid {
      grid-template-columns: 1fr;
    }
  }
  .lp-tile {
    overflow: hidden;
    border-radius: 1.25rem;
    border: 1px solid var(--line);
    background: #fff;
    display: grid;
    transition: transform 0.6s var(--ease), box-shadow 0.6s var(--ease);
  }
  .lp-tile:hover {
    transform: translateY(-4px);
    box-shadow: 0 24px 48px -24px oklch(0.2 0.03 255 / 0.35);
  }
  .lp-art {
    aspect-ratio: 3 / 2;
    overflow: hidden;
  }
  .lp-art svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .lp-body {
    padding: 1.5rem 1.5rem 1.75rem;
  }
  .lp-body h3 {
    font-size: 2rem;
    line-height: 1.2;
  }
  .lp-feel {
    margin: 0.15rem 0 0.75rem;
    font-weight: 500;
  }
  .lp-body > p:not(.lp-feel) {
    margin: 0;
    color: var(--muted);
  }
  .lp-links {
    margin-top: 1.25rem;
    display: grid;
    border-top: 1px solid var(--line);
  }
  .lp-links a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: var(--ink);
    text-decoration: none;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--line);
    font-weight: 500;
    transition: color 0.3s, border-color 0.3s;
  }
  .lp-links a small {
    font-size: inherit;
    color: var(--muted);
    font-weight: 400;
  }
  .lp-links a svg {
    color: var(--muted);
    transition: translate 0.5s var(--ease), color 0.3s;
  }
  .lp-links a:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .lp-links a:hover svg {
    color: var(--accent);
    translate: 5px 0;
  }

  /* Each tile previews its direction's palette. */
  .lp-tile-prestige {
    --art-sky: oklch(0.36 0.1 22);
    --art-sun: oklch(0.84 0.09 190);
    --art-far: oklch(0.5 0.11 22);
    --art-near: oklch(0.15 0.05 22);
  }
  /* Drawn a little oversize, so a ridge the script has lifted never shows its foot. */
  .lp-tile-prestige .lp-art svg {
    transform: scale(1.12);
  }
  .lp-tile-warmth {
    --art-bg: oklch(0.9 0.17 95);
    --art-1: oklch(0.3 0.09 335);
    --art-2: oklch(0.74 0.16 35);
    --art-3: oklch(0.9 0.08 165);
    --art-4: oklch(0.84 0.09 305);
    --art-5: oklch(0.99 0.005 95);
  }
  .lp-tile-wow .lp-art {
    background: #f4f4f0;
    --art-1: #1a5cf0;
    --art-2: #ff4577;
    --art-3: #ffd21f;
    --cv-font: 'Besley Variable', Georgia, serif;
  }
  .lp-tile-calm {
    --art-1: oklch(0.965 0.014 250);
    --art-2: oklch(0.89 0.045 250);
    --art-3: oklch(0.83 0.055 250);
    --art-4: oklch(0.62 0.08 250);
    --art-sun: oklch(0.99 0.008 250);
  }

  .lp-services {
    padding: clamp(4rem, 8vw, 7rem) clamp(1.25rem, 5vw, 4rem);
    border-top: 1px solid var(--line);
  }
  .lp-svc {
    margin-top: 2.5rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 2.5rem 3rem;
    max-width: 70rem;
  }
  .lp-svc > div {
    position: relative;
    padding-top: 1.25rem;
  }
  .lp-svc > div::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 1px;
    background: var(--line);
    transform-origin: left;
  }
  .lp-svc h3 {
    font-size: 1.5rem;
    font-weight: 400;
    margin-bottom: 0.4rem;
  }
  .lp-svc p {
    margin: 0;
    color: var(--muted);
  }
  .lp-fine {
    margin: 3rem 0 0;
    max-width: 40rem;
    font-size: 0.95rem;
    color: var(--muted);
  }
  .lp-foot {
    padding: 2rem clamp(1.25rem, 5vw, 4rem) 3rem;
    border-top: 1px solid var(--line);
    font-size: 0.9rem;
    color: var(--muted);
  }

  /* ---- motion: always an enhancement over a fully visible page ---- */
  @media (prefers-reduced-motion: no-preference) {
    html:not(.lenis) {
      scroll-behavior: smooth;
    }

    /* Arrival: the headline rises a word at a time from behind its own baseline, "you" last. */
    .lp-word {
      clip-path: inset(-0.2em -0.3em -0.32em);
    }
    .lp-word > span {
      animation: lp-up 1.1s var(--ease) calc(0.1s + var(--w) * 55ms) backwards;
    }
    .lp-word:last-child > span {
      animation-delay: calc(0.3s + var(--w) * 55ms);
    }
    .lp-top,
    .lp-hero p,
    .lp-cta {
      animation: lp-fade 1.2s var(--ease) backwards;
    }
    .lp-hero p {
      animation-delay: 0.75s;
    }
    .lp-cta {
      animation-delay: 0.9s;
    }
    @keyframes lp-up {
      from {
        translate: 0 130%;
      }
    }
    @keyframes lp-fade {
      from {
        opacity: 0;
        translate: 0 0.9rem;
      }
    }

    /*
     * Each tile is its direction in miniature. Prestige's ridges, Calm's sun and Wow's inks are
     * moved by src/scripts/landing.ts, which also marks a tile .is-live while it is on screen;
     * Warmth's cut-outs drift and Calm's water shimmers here.
     */
    .lp-tile-warmth .art-piece {
      transform-box: fill-box;
      transform-origin: center;
    }
    .lp-tile-warmth.is-live .art-piece {
      animation: lp-drift calc(7s + var(--n) * 0.9s) ease-in-out calc(var(--n) * -1.7s) infinite alternate;
    }
    .lp-tile-warmth.is-live .art-piece:nth-child(even) {
      animation-direction: alternate-reverse;
    }
    .lp-tile-calm .art-glint {
      transform-box: fill-box;
      transform-origin: center;
    }
    .lp-tile-calm.is-live .art-glint {
      animation: lp-glint calc(3.4s + var(--n) * 0.37s) ease-in-out calc(var(--n) * -0.9s) infinite;
    }
    @keyframes lp-drift {
      from {
        translate: -5px 8px;
      }
      to {
        translate: 6px -10px;
      }
    }
    @keyframes lp-glint {
      50% {
        opacity: 0.2;
        scale: 0.7 1;
      }
    }

    /*
     * Scroll reveals, held back only while html.lp-js says the script is on its way
     * (src/scripts/landing.ts adds .is-in). Headings rise from behind their baseline as the
     * headline does, a tile comes up while its picture settles into the frame, and each service
     * has its rule drawn before its text arrives.
     */
    .lp-js .lp [data-rv] {
      --dl: calc(var(--d, 0) * 120ms);
    }
    .lp-js .lp [data-rv='up'] {
      clip-path: inset(-0.1em -0.1em -0.35em);
      transition: clip-path 1.2s var(--ease) var(--dl), translate 1.2s var(--ease) var(--dl);
    }
    .lp-js .lp [data-rv='up']:not(.is-in) {
      clip-path: inset(-0.1em -0.1em 100%);
      translate: 0 0.45em;
    }
    .lp-js .lp [data-rv='rise'] {
      transition: opacity 1.1s var(--ease) var(--dl), translate 1.1s var(--ease) var(--dl);
    }
    .lp-js .lp [data-rv='rise']:not(.is-in) {
      opacity: 0;
      translate: 0 1.25rem;
    }
    .lp-js .lp [data-rv='tile'] {
      transition: opacity 0.9s var(--ease) var(--dl), translate 1.3s var(--ease) var(--dl),
        transform 0.6s var(--ease), box-shadow 0.6s var(--ease);
    }
    .lp-js .lp [data-rv='tile'] .lp-art svg {
      transition: scale 1.8s var(--ease) var(--dl);
    }
    .lp-js .lp [data-rv='tile']:not(.is-in) {
      opacity: 0;
      translate: 0 2.5rem;
    }
    .lp-js .lp [data-rv='tile']:not(.is-in) .lp-art svg {
      scale: 1.14;
    }
    /* Wow's inks roll on one after another, and Warmth's cut-outs are dropped onto their ground. */
    .lp-js .lp-tile-wow[data-rv] .lp-art text {
      transition: clip-path 0.9s cubic-bezier(0.45, 0, 0.2, 1) calc(var(--dl) + 0.1s);
    }
    .lp-js .lp-tile-wow[data-rv] .lp-art text:nth-child(2) {
      transition-delay: calc(var(--dl) + 0.3s);
    }
    .lp-js .lp-tile-wow[data-rv] .lp-art text:nth-child(3) {
      transition-delay: calc(var(--dl) + 0.5s);
    }
    .lp-js .lp-tile-wow[data-rv]:not(.is-in) .lp-art text {
      clip-path: inset(-10% -10% 110% -10%);
    }
    .lp-js .lp-tile-wow[data-rv].is-in .lp-art text {
      clip-path: inset(-10%);
    }
    .lp-js .lp-tile-warmth[data-rv] .art-piece {
      --pd: calc(var(--dl) + 0.25s + var(--n) * 60ms);
      transition: opacity 0.4s ease-out var(--pd), scale 0.8s var(--ease) var(--pd), rotate 0.8s var(--ease) var(--pd);
    }
    .lp-js .lp-tile-warmth[data-rv]:not(.is-in) .art-piece {
      opacity: 0;
      scale: 1.4;
      rotate: 20deg;
    }
    .lp-js .lp [data-rv='row']::before {
      transition: transform 1.5s var(--ease) var(--dl);
    }
    .lp-js .lp [data-rv='row'] > * {
      transition: opacity 1.1s var(--ease) calc(var(--dl) + 0.2s), translate 1.1s var(--ease) calc(var(--dl) + 0.2s);
    }
    .lp-js .lp [data-rv='row']:not(.is-in)::before {
      transform: scaleX(0);
    }
    .lp-js .lp [data-rv='row']:not(.is-in) > * {
      opacity: 0;
      translate: 0 0.75rem;
    }
  }
</style>
