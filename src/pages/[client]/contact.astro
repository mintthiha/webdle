---
import ClientLayout from '../../layouts/ClientLayout.astro';
import { getClients } from '../../lib/clients';
import type { Client } from '../../schemas/client';

export function getStaticPaths() {
  return getClients().map((client) => ({ params: { client: client.slug }, props: { client } }));
}

const { client } = Astro.props as { client: Client };
const intro =
  client.archetype === 'teacher'
    ? 'Speaking, consulting, collaboration, or a question — send a note.'
    : 'Press, events, rights, or just a hello — send a note.';
const field =
  'w-full rounded-md border border-line bg-card px-4 py-3 focus:outline-2 focus:outline-accent';
---

<ClientLayout client={client} title="Contact" current="contact">
  <div class="mx-auto max-w-2xl px-6 pt-16">
    <h1 class="font-display text-4xl sm:text-5xl tracking-tight mb-4">Contact</h1>
    <p class="text-muted mb-10">{intro}</p>

    <!-- [TODO: form endpoint] No form service chosen yet; the form is inert in this demo. -->
    <form class="space-y-5">
      <div>
        <label for="name" class="block text-sm font-medium mb-1">Name</label>
        <input id="name" name="name" type="text" class={field} />
      </div>
      <div>
        <label for="email" class="block text-sm font-medium mb-1">Email</label>
        <input id="email" name="email" type="email" class={field} />
      </div>
      <div>
        <label for="message" class="block text-sm font-medium mb-1">Message</label>
        <textarea id="message" name="message" rows="6" class={field}></textarea>
      </div>
      <button
        type="button"
        disabled
        class="bg-accent text-accent-ink px-6 py-3 rounded-md font-medium opacity-50 cursor-not-allowed"
      >
        Send message
      </button>
      <p class="text-sm text-muted">Demo only — the contact form is not connected on sample sites.</p>
    </form>
  </div>
</ClientLayout>
