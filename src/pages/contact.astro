---
import '@fontsource/spectral/300.css';
import '@fontsource/spectral/300-italic.css';
import '@fontsource/spectral/400.css';
import '@fontsource-variable/public-sans/wght.css';
import '../styles/global.css';
import ShareTags from '../components/ShareTags.astro';
import { contact, roles } from '../lib/contact';

const title = 'Contact · webdle';
const description =
  'Tell webdle a little about you and what you teach or write, and talk through what your personal website should be.';
const hasForm = contact.web3formsKey !== '';
const mailto = `mailto:${contact.email}?subject=${encodeURIComponent('A website from webdle')}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f8f9fc" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <ShareTags
      title={title}
      description={description}
      image="home"
      imageAlt="The webdle headline beside four sample designs fanned like a hand of cards: Prestige, Warmth, Wow and Calm"
    />
  </head>
  <body>
    <div class="ct">
      <header class="ct-top">
        <a class="ct-mark" href="/">webdle</a>
        <nav class="ct-nav" aria-label="Site">
          <a class="ct-jump" href="/#designs">See the designs</a>
          <a class="ct-jump" href="/contact/" aria-current="page">Get in touch</a>
        </nav>
      </header>

      <main class="ct-main">
        <div class="ct-intro">
          <div data-ask>
            <h1>Let’s talk about <em>your</em> site.</h1>
            <p>
              Send a few lines about who you are and what you teach or write. Your message goes straight to {contact.name}, who runs webdle.
            </p>
            <p class="ct-alt">
              {hasForm ? 'Prefer email?' : 'Write to'}
              <a class="ct-mail" href={mailto}>{contact.email}</a>
            </p>
          </div>
          {
            hasForm && (
              <div class="ct-done" data-done role="status" tabindex="-1" hidden>
                <h1>Thank you.</h1>
                <p>Your message has been sent to {contact.name}.</p>
                <p class="ct-alt">
                  <a class="ct-mail" href="/#designs">See the sample designs</a>
                </p>
              </div>
            )
          }
        </div>

        {
          hasForm && (
            <div class="ct-panel">
              <form
                class="ct-form"
                action="https://api.web3forms.com/submit"
                method="POST"
                data-form
              >
                <input type="hidden" name="access_key" value={contact.web3formsKey} />
                <input type="hidden" name="subject" value="A website from webdle" />
                <input type="hidden" name="from_name" value="webdle contact page" />
                {/* A honeypot: people never see it, so only a bot fills it in. */}
                <input type="checkbox" name="botcheck" class="ct-hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

                <div class="ct-field">
                  <label for="ct-name">Your name</label>
                  <input id="ct-name" name="name" type="text" autocomplete="name" required maxlength="120" />
                </div>

                <div class="ct-field">
                  <label for="ct-email">Your email</label>
                  <input id="ct-email" name="email" type="email" autocomplete="email" required maxlength="200" />
                </div>

                <fieldset class="ct-field ct-roles">
                  <legend>I am a</legend>
                  <div class="ct-choices">
                    {roles.map((r, i) => (
                      <label class="ct-choice">
                        <input type="radio" name="role" value={r} checked={i === 0} />
                        <span>{r}</span>
                      </label>
                    ))}
                  </div>
                </fieldset>

                <div class="ct-field">
                  <label for="ct-message">A few lines about you</label>
                  <textarea id="ct-message" name="message" rows="6" required maxlength="4000" />
                </div>

                <p class="ct-error" data-error role="alert" hidden>
                  That did not go through. Please try again, or write to
                  <a href={mailto}>{contact.email}</a>.
                </p>

                <button class="ct-send" type="submit">
                  <span data-label>Send message</span>
                  <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M2.5 8h11M9 3.5 13.5 8 9 12.5" /></svg>
                </button>
              </form>
            </div>
          )
        }
      </main>

      <footer class="ct-foot">
        <span>© {new Date().getFullYear()} webdle</span>
        <a href="/">Back to the designs</a>
      </footer>
    </div>
  </body>
</html>

<script>
  // The form works without this (it posts to Web3Forms and they show a thank-you page). With it,
  // the message is sent in the background and the thank-you replaces the form on this page.
  const form = document.querySelector<HTMLFormElement>('[data-form]');
  if (form) {
    const main = document.querySelector<HTMLElement>('.ct-main')!;
    const ask = document.querySelector<HTMLElement>('[data-ask]')!;
    const done = document.querySelector<HTMLElement>('[data-done]')!;
    const error = form.querySelector<HTMLElement>('[data-error]')!;
    const button = form.querySelector<HTMLButtonElement>('.ct-send')!;
    const label = form.querySelector<HTMLElement>('[data-label]')!;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      error.hidden = true;
      button.disabled = true;
      label.textContent = 'Sending…';
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });
        const data = await res.json();
        if (!res.ok || !data.success) throw new Error(data.message || String(res.status));
        main.classList.add('is-sent');
        ask.hidden = true;
        done.hidden = false;
        done.focus();
      } catch {
        error.hidden = false;
        button.disabled = false;
        label.textContent = 'Send message';
      }
    });
  }
</script>

<style is:global>
  html {
    background: oklch(0.985 0.004 250);
    scrollbar-color: oklch(0.72 0.02 255) oklch(0.96 0.006 250);
  }
  .ct {
    --ink: oklch(0.22 0.02 255);
    --muted: oklch(0.44 0.02 255);
    --line: oklch(0.88 0.01 255);
    --accent: oklch(0.45 0.09 250);
    --ease: cubic-bezier(0.16, 1, 0.3, 1);
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    font-family: 'Public Sans Variable', ui-sans-serif, system-ui, sans-serif;
    color: var(--ink);
    line-height: 1.65;
    font-size: 1.0625rem;
    overflow-x: clip;
  }
  .ct ::selection {
    background: var(--accent);
    color: oklch(0.985 0.004 250);
  }
  .ct h1,
  .ct h2 {
    font-family: 'Spectral', Georgia, serif;
    font-weight: 300;
    margin: 0;
    text-wrap: balance;
    letter-spacing: -0.01em;
  }
  .ct a:focus-visible,
  .ct button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .ct [tabindex='-1']:focus {
    outline: none;
  }
  .ct a > svg,
  .ct button > svg {
    flex: none;
    width: 1em;
    height: 1em;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ct-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 1.75rem clamp(1.25rem, 5vw, 4rem);
  }
  .ct-mark {
    font-family: 'Spectral', serif;
    font-size: 1.5rem;
    color: var(--ink);
    text-decoration: none;
  }
  .ct-nav {
    display: flex;
    gap: clamp(1rem, 3vw, 2rem);
  }
  .ct-jump {
    color: var(--accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
    transition: text-underline-offset 0.4s var(--ease), color 0.3s;
  }
  .ct-jump:hover {
    color: var(--ink);
    text-underline-offset: 8px;
  }
  /* The page you are on is marked, not linked to itself. */
  .ct-jump[aria-current='page'] {
    color: var(--ink);
    text-decoration-color: var(--line);
  }

  .ct-main {
    flex: 1;
    padding: clamp(2.5rem, 7vw, 6rem) clamp(1.25rem, 5vw, 4rem) clamp(3rem, 7vw, 6rem);
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
    align-content: start;
  }
  .ct-intro h1 {
    font-size: clamp(2.4rem, 6vw, 4.5rem);
    line-height: 1.06;
  }
  .ct-intro em {
    color: var(--accent);
  }
  .ct-intro p {
    margin: 1.5rem 0 0;
    max-width: 34rem;
    font-size: clamp(1.1rem, 1.6vw, 1.25rem);
    color: var(--muted);
  }
  /* The address is written out, so it can be copied by anyone whose browser has no mail app. */
  .ct-intro .ct-alt {
    margin-top: 2rem;
    font-size: 1rem;
  }
  .ct-mail {
    color: var(--ink);
    overflow-wrap: anywhere;
    text-decoration: underline 1px var(--line);
    text-underline-offset: 0.22em;
    transition: color 0.3s, text-decoration-color 0.3s;
  }
  .ct-mail:hover {
    color: var(--accent);
    text-decoration-color: currentColor;
  }
  /* With no form, the address is the whole page: set it large, as the landing page does. */
  .ct-intro .ct-alt:last-child {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25em 0.75em;
  }
  .ct-main:not(:has(.ct-panel)) .ct-mail {
    font-family: 'Spectral', Georgia, serif;
    font-weight: 300;
    font-size: clamp(1.5rem, 4vw, 2.75rem);
    line-height: 1.2;
  }

  .ct-panel {
    max-width: 36rem;
  }
  .ct-form {
    display: grid;
    gap: 1.5rem;
  }
  .ct-field {
    display: grid;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  .ct-field label,
  .ct-field legend {
    padding: 0;
    font-size: 0.9rem;
    font-weight: 600;
  }
  .ct-field input[type='text'],
  .ct-field input[type='email'],
  .ct-field textarea {
    width: 100%;
    box-sizing: border-box;
    padding: 0.8rem 1rem;
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    background: #fff;
    color: var(--ink);
    font: inherit;
    transition: border-color 0.3s, box-shadow 0.3s;
  }
  .ct-field textarea {
    resize: vertical;
    min-height: 9rem;
  }
  .ct-field input[type='text']:hover,
  .ct-field input[type='email']:hover,
  .ct-field textarea:hover {
    border-color: oklch(0.72 0.02 255);
  }
  .ct-field input:focus-visible,
  .ct-field textarea:focus-visible {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px oklch(0.45 0.09 250 / 0.18);
  }
  /* The three roles are chips: the radio is the real control, kept visible to assistive tech. */
  .ct-choices {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .ct-choice {
    position: relative;
    font-weight: 400;
  }
  .ct-choice input {
    position: absolute;
    inset: 0;
    opacity: 0;
    margin: 0;
    cursor: pointer;
  }
  .ct-choice span {
    display: block;
    padding: 0.55rem 1.1rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: #fff;
    font-size: 0.95rem;
    font-weight: 400;
    transition: border-color 0.3s, background 0.3s, color 0.3s;
  }
  .ct-choice:hover span {
    border-color: oklch(0.72 0.02 255);
  }
  .ct-choice input:checked + span {
    border-color: var(--ink);
    background: var(--ink);
    color: oklch(0.985 0.004 250);
  }
  .ct-choice input:focus-visible + span {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .ct-hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .ct-error {
    margin: 0;
    padding: 0.8rem 1rem;
    border-radius: 0.75rem;
    border: 1px solid oklch(0.78 0.09 25);
    background: oklch(0.97 0.02 25);
    color: oklch(0.38 0.12 25);
    font-size: 0.95rem;
  }
  .ct-error[hidden],
  .ct-done[hidden],
  [data-ask][hidden] {
    display: none;
  }
  /* Once sent, the thank-you takes the place of the headline and the form goes. */
  .ct-main.is-sent .ct-panel {
    display: none;
  }
  .ct-error a {
    color: inherit;
  }
  .ct-send {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.95rem 1.5rem 0.95rem 1.7rem;
    border: 0;
    border-radius: 999px;
    background: var(--ink);
    color: oklch(0.985 0.004 250);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.3s, scale 0.3s var(--ease), opacity 0.3s;
  }
  .ct-send svg {
    transition: translate 0.5s var(--ease);
  }
  .ct-send:hover {
    background: var(--accent);
  }
  .ct-send:hover svg {
    translate: 3px 0;
  }
  .ct-send:active {
    scale: 0.97;
    transition-duration: 0.1s;
  }
  .ct-send:disabled {
    opacity: 0.6;
    cursor: progress;
  }

  /* Wide screens: the question keeps the left edge and the form answers it from the right. */
  @media (min-width: 64rem) {
    .ct-main {
      grid-template-columns: minmax(0, 1fr) minmax(0, 36rem);
      gap: clamp(3rem, 7vw, 8rem);
    }
    .ct-main:not(:has(.ct-panel)),
    .ct-main.is-sent {
      grid-template-columns: minmax(0, 1fr);
    }
    .ct-panel {
      padding-top: 0.5rem;
    }
  }
  @media (max-width: 40rem) {
    .ct-nav {
      gap: 1rem;
      font-size: 0.95rem;
    }
  }

  .ct-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding: 2rem clamp(1.25rem, 5vw, 4rem) 3rem;
    border-top: 1px solid var(--line);
    font-size: 0.9rem;
    color: var(--muted);
  }
  .ct-foot a {
    color: var(--accent);
    text-underline-offset: 4px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .ct-top,
    .ct-intro > *,
    .ct-panel {
      animation: ct-fade 1.1s var(--ease) backwards;
    }
    .ct-intro > :nth-child(2) {
      animation-delay: 0.15s;
    }
    .ct-intro > :nth-child(3) {
      animation-delay: 0.25s;
    }
    .ct-panel {
      animation-delay: 0.3s;
    }
    @keyframes ct-fade {
      from {
        opacity: 0;
        translate: 0 0.9rem;
      }
    }
  }
</style>
