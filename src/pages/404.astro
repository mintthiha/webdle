---
import '@fontsource/spectral/300.css';
import '@fontsource/spectral/300-italic.css';
import '@fontsource-variable/public-sans/wght.css';
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f8f9fc" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>Page not found · webdle</title>
  </head>
  <body>
    <div class="nf">
      <header class="nf-top">
        <a class="nf-mark" href="/">webdle</a>
      </header>

      <main class="nf-main">
        <p class="nf-code">404</p>
        <h1>There is no page at <em>this address</em>.</h1>
        <p class="nf-copy">The link may be mistyped, or the page may have moved.</p>
        <div class="nf-links">
          <a class="nf-cta" href="/">
            <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M13.5 8h-11M7 3.5 2.5 8 7 12.5" /></svg>
            Back to webdle
          </a>
          <a class="nf-jump" href="/#designs">See the sample designs</a>
        </div>
      </main>

      <footer class="nf-foot">© {new Date().getFullYear()} webdle</footer>
    </div>
  </body>
</html>

<style>
  /* The landing page's world (src/pages/index.astro): same paper, ink, type and button. */
  html {
    background: oklch(0.985 0.004 250);
  }
  .nf {
    --ink: oklch(0.22 0.02 255);
    --muted: oklch(0.44 0.02 255);
    --line: oklch(0.88 0.01 255);
    --accent: oklch(0.45 0.09 250);
    --ease: cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    font-family: 'Public Sans Variable', ui-sans-serif, system-ui, sans-serif;
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--ink);
  }
  .nf a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .nf-top {
    padding: 1.75rem clamp(1.25rem, 5vw, 4rem);
  }
  .nf-mark {
    font-family: 'Spectral', serif;
    font-size: 1.5rem;
    color: var(--ink);
    text-decoration: none;
  }
  .nf-main {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    max-width: 62rem;
    padding: clamp(3rem, 8vw, 6rem) clamp(1.25rem, 5vw, 4rem);
  }
  .nf-code {
    margin: 0 0 1rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .nf h1 {
    margin: 0;
    font-family: 'Spectral', Georgia, serif;
    font-weight: 300;
    font-size: clamp(2.4rem, 6vw, 4.5rem);
    line-height: 1.06;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .nf h1 em {
    color: var(--accent);
  }
  .nf-copy {
    margin: 1.5rem 0 0;
    font-size: clamp(1.15rem, 1.8vw, 1.35rem);
    color: var(--muted);
  }
  .nf-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2rem;
    margin-top: 2.25rem;
  }
  .nf-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.95rem 1.7rem 0.95rem 1.5rem;
    border-radius: 999px;
    background: var(--ink);
    color: oklch(0.985 0.004 250);
    text-decoration: none;
    font-weight: 600;
    transition: background 0.3s, scale 0.3s var(--ease);
  }
  .nf-cta svg {
    flex: none;
    width: 1em;
    height: 1em;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: translate 0.5s var(--ease);
  }
  .nf-cta:hover {
    background: var(--accent);
  }
  .nf-cta:hover svg {
    translate: -3px 0;
  }
  .nf-cta:active {
    scale: 0.97;
    transition-duration: 0.1s;
  }
  .nf-jump {
    color: var(--accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
    transition: text-underline-offset 0.4s var(--ease), color 0.3s;
  }
  .nf-jump:hover {
    color: var(--ink);
    text-underline-offset: 8px;
  }
  .nf-foot {
    padding: 2rem clamp(1.25rem, 5vw, 4rem) 3rem;
    border-top: 1px solid var(--line);
    font-size: 0.9rem;
    color: var(--muted);
  }

  @media (prefers-reduced-motion: no-preference) {
    .nf-main > * {
      animation: nf-in 1.1s var(--ease) backwards;
    }
    .nf-main > :nth-child(2) {
      animation-delay: 0.08s;
    }
    .nf-main > :nth-child(3) {
      animation-delay: 0.2s;
    }
    .nf-main > :nth-child(4) {
      animation-delay: 0.32s;
    }
    @keyframes nf-in {
      from {
        opacity: 0;
        translate: 0 0.75rem;
      }
    }
  }
</style>
