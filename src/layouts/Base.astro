---
import '../styles/global.css';
import type { Client } from '../schemas/client';
import DemoSwitcher from '../components/DemoSwitcher.astro';
import ShareTags from '../components/ShareTags.astro';
import SearchPreview from '../components/SearchPreview.astro';
import { classic, directions, type DirectionSlug } from '../lib/view';
import { searchData } from '../lib/seo';
import { strings, type Lang } from '../lib/i18n';

interface Props {
  client: Client;
  direction: DirectionSlug;
  title: string;
  themeColor: string;
  /** The meta description; defaults to the tagline. */
  description?: string;
  /** The page's language; `client` should already be in it. */
  lang?: Lang;
  /** This page in each language it exists in, for hreflang links. */
  alternates?: { lang: Lang; href: string }[];
}

const { client, direction, title, themeColor, description = client.tagline, lang = 'en', alternates = [] } = Astro.props;
const abs = (p: string) => (Astro.site ? new URL(p, Astro.site).href : p);

const { jsonLd } = searchData(client, lang);
/** This page's address on the client's own site: /classic/jane-teacher/about/ is /about/ there. */
const sitePath = Astro.url.pathname.replace(`/${direction}/${client.slug}`, '') || '/';
const design = [...directions, classic].find((d) => d.slug === direction)!.name;
---

<!doctype html>
<html lang={strings[lang].htmlLang} data-direction={direction}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={themeColor} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {alternates.length > 1 && alternates.map((a) => <link rel="alternate" hreflang={strings[a.lang].htmlLang} href={abs(a.href)} />)}
    {/* Sample sites are about fictional people, so search engines are asked to leave them out. */}
    <meta name="robots" content="noindex" />
    <ShareTags
      title={title}
      description={`A sample site by webdle with fictional content, in the ${design} design. ${client.tagline}`}
      image={`${direction}-${client.slug}`}
      imageAlt={`The top of the ${design} sample site for ${client.name}`}
    />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      // How this page was reached decides how it arrives. From a tile on the landing page, it opens
      // out of that tile (vt-open, styles/global.css). From another page of the same multi-page
      // site, the page turns under a header that stays put (vt-turn, templates/Classic.astro).
      addEventListener('pagereveal', function (e) {
        if (!e.viewTransition) return;
        var root = document.documentElement;
        var from = null;
        var turn = 0;
        try {
          from = JSON.parse(sessionStorage.getItem('webdle-open'));
          turn = Number(sessionStorage.getItem('webdle-turn'));
          sessionStorage.removeItem('webdle-open');
          sessionStorage.removeItem('webdle-turn');
        } catch (err) {}
        var kind = Date.now() - turn < 4000 ? 'vt-turn' : from && Date.now() - from.at < 4000 ? 'vt-open' : '';
        if (!kind) return;
        if (kind === 'vt-open') {
          ['t', 'r', 'b', 'l'].forEach(function (side) {
            root.style.setProperty('--vt-' + side, from[side] + 'px');
          });
        }
        root.classList.add(kind);
        e.viewTransition.finished.then(function () {
          root.classList.remove(kind);
        });
      });
    </script>
  </head>
  <body>
    <slot />
    <DemoSwitcher clientSlug={client.slug} current={direction}>
      <SearchPreview client={client} title={title} description={description} path={sitePath} />
    </DemoSwitcher>
  </body>
</html>
