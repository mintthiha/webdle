---
import '../styles/global.css';
import type { Client } from '../schemas/client';

interface Props {
  client: Client;
  title: string;
  description?: string;
  current: 'home' | 'about' | 'work' | 'contact';
}

const { client, title, description, current } = Astro.props;
const base = `/${client.slug}`;
const workLabel = client.archetype === 'teacher' ? 'Teaching' : 'Writing';
const nav = [
  { key: 'home', label: 'Home', href: `${base}/` },
  { key: 'about', label: 'About', href: `${base}/about/` },
  { key: 'work', label: workLabel, href: `${base}/work/` },
  { key: 'contact', label: 'Contact', href: `${base}/contact/` },
] as const;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: client.name,
  description: client.tagline,
  url: client.domain,
  ...(client.sameAs.length > 0 && { sameAs: client.sameAs }),
};
---

<!doctype html>
<html lang="en" data-theme={client.archetype}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {client.name}</title>
    <meta name="description" content={description ?? client.tagline} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="bg-paper text-ink min-h-screen flex flex-col">
    <div class="bg-ink text-paper text-sm">
      <div class="mx-auto max-w-5xl px-6 py-2 flex flex-wrap items-center justify-between gap-2">
        <span>Sample site with fictional content — a demo by webdle.</span>
        <a href="/" class="underline underline-offset-4 hover:no-underline">← All demos</a>
      </div>
    </div>

    <header class="border-b border-line">
      <div class="mx-auto max-w-5xl px-6 py-5 flex flex-wrap items-center justify-between gap-4">
        <a href={`${base}/`} class="font-display text-2xl tracking-tight">{client.name}</a>
        <nav aria-label="Main">
          <ul class="flex gap-6 text-sm font-medium">
            {nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={current === item.key ? 'page' : undefined}
                  class:list={[
                    'pb-1 border-b-2 hover:text-accent',
                    current === item.key ? 'border-accent text-accent' : 'border-transparent text-muted',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-line mt-16">
      <div class="mx-auto max-w-5xl px-6 py-8 text-sm text-muted flex flex-wrap justify-between gap-2">
        <span>© {new Date().getFullYear()} {client.name}</span>
        <span>{client.location}</span>
      </div>
    </footer>
  </body>
</html>
