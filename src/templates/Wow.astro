---
import '@fontsource-variable/besley/wght.css';
import '@fontsource/league-gothic/400.css';
import Base from '../layouts/Base.astro';
import { toView } from '../lib/view';
import type { Client } from '../schemas/client';

interface Props {
  client: Client;
}
const { client } = Astro.props;
const v = toView(client);

/*
 * The page is a wood-type broadside printed in three transparent inks: yellow (y), pink (p) and
 * blue (b). `data-ink` names the plates an element is locked into; two letters means it is printed
 * twice, which makes the overprint colour. src/scripts/wow-press.ts does the printing; without it
 * the same elements fall back to flat CSS colour.
 */
const LOCKUP = ['b', 'p', 'y', 'pb', 'yp', 'b', 'y', 'p', 'yb', 'p', 'b', 'yp'];
const lockup = (text: string, inks: string[], start = 0) => {
  let slot = start;
  return [...text].map((ch) => ({ ch, ink: ch.trim() ? inks[slot++ % inks.length] : '' }));
};

/*
 * Rough font-size-per-measure for a fitted line, used until the script measures the real glyphs
 * (and for good when there is no script). They err on the narrow side so a line never overflows.
 */
const CLAR_WIDTHS: [RegExp, number][] = [
  [/[MW]/, 1.1],
  [/[mw]/, 0.95],
  [/[A-Z]/, 0.72],
  [/[ijl.,:;!’']/, 0.42],
  [/[frt]/, 0.52],
];
const kClar = (text: string) =>
  (1 / [...text].reduce((sum, ch) => sum + (CLAR_WIDTHS.find(([re]) => re.test(ch))?.[1] ?? 0.61), 0)).toFixed(4);
const kGoth = (text: string) => (1 / (text.length * 0.35)).toFixed(4);
const clarBox = (text: string) =>
  `--asc:${/’/.test(text) ? 0.87 : /[bdfhklt]/.test(text) ? 0.78 : /[A-Z0-9]/.test(text) ? 0.75 : 0.54};--desc:${/[gjpqy,;]/.test(text) ? 0.22 : 0.02}`;

const first = lockup(v.firstName, LOCKUP);
const nameLines = [
  { word: v.firstName, letters: first },
  ...(v.lastName ? [{ word: v.lastName, letters: lockup(v.lastName, LOCKUP, v.firstName.length) }] : []),
];
const roleLine = [v.role, client.location ?? (v.since ? `Since ${v.since}` : v.workLabel)].join(' · ');

const words = client.bio.split(' ');

const now = v.current
  ? [v.nowLabel, v.current.role, v.current.institution]
  : v.latest
    ? [v.nowLabel, v.latest.title, `${v.latest.venue}, ${v.latest.year}`]
    : [];
const NOW_INKS = ['yp', 'b', 'p'];

const record = [
  ...v.roles.map((r) => ({
    year: r.startYear,
    period: v.period(r.startYear, r.endYear),
    title: r.role,
    where: [r.institution, r.department].filter(Boolean).join(' · '),
  })),
  ...v.education.map((c) => ({
    year: c.year,
    period: String(c.year),
    title: c.degree,
    where: [c.institution, c.location].filter(Boolean).join(', '),
  })),
].sort((a, b) => b.year - a.year);
const YEAR_INKS = ['pb', 'yp', 'yb', 'p', 'b', 'y'];

const courses = v.courses.map((c) => ({ title: c.course, meta: c.institution, url: undefined as string | undefined }));
const publications = v.publications.map((p) => ({
  title: p.title,
  meta: `${v.typeLabel[p.type]} · ${p.venue} · ${p.year}`,
  url: p.url,
}));
const writer = client.archetype === 'writer';
const bands = writer ? publications : courses;
const also = writer ? courses : publications;
const BAND_INKS = ['y', 'p', 'b'];
const tape = (bands.length ? bands : also).map((row) => row.title);
const RAG = [0, 15, 5, 24, 9, 18];

const TALK = 'Let’s talk.';
let talkSlot = 0;
const talkLines = TALK.split(' ').map((word) => {
  const letters = lockup(word, ['y', 'yp', 'p'], talkSlot);
  talkSlot += word.length;
  return { word, letters };
});

const sections = [
  { id: 'about', label: 'About', ink: 'p' },
  { id: 'record', label: 'Record', ink: 'y' },
  { id: 'work', label: v.workLabel, ink: 'b' },
  { id: 'talk', label: 'Contact', ink: 'yp' },
];
const SWATCHES = ['y', 'p', 'b', 'yp', 'yb', 'pb', 'ypb'];
---

<Base client={client} direction="wow" title={`${client.name} · ${v.role}`} themeColor="#f4f4f0">
  <script is:inline>
    // Hold the flat CSS inks back while the press warms up; give them back if it never does.
    document.documentElement.classList.add('wo-js');
    setTimeout(function () {
      if (!document.querySelector('.wo.is-press')) document.documentElement.classList.remove('wo-js');
    }, 6000);
  </script>

  <div class="wo">
    <nav class="wo-nav" aria-label="Main">
      <a class="wo-nav-home" href="#top">{client.name}</a>
      <ul>
        {sections.map((s) => (
          <li>
            <a href={`#${s.id}`}><i style={`--c:var(--${s.ink})`} aria-hidden="true" />{s.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="wo-stage">
      <div class="wo-pin">
        <section class="wo-sheet wo-hero" id="top" data-sheet="hero">
          <canvas class="wo-ink" aria-hidden="true"></canvas>
          <div class="wo-hero-body">
            <div class="wo-top">
              <div class="wo-marks" aria-hidden="true">
                <span class="wo-swatches">{SWATCHES.map((ink) => <i data-ink={ink} data-rect />)}</span>
                <svg class="wo-target" viewBox="0 0 24 24"><circle cx="12" cy="12" r="6.5" /><path d="M12 0v24M0 12h24" /></svg>
              </div>
              <!-- Shown by the script: deals the inks to different letters and pulls the sheet again. -->
              <button class="wo-pull" type="button" hidden>Print it again</button>
            </div>

            <div class="wo-poster">
              <h1 class="wo-name" aria-label={client.name}>
                {nameLines.map((line, i) => (
                  <Fragment>
                    {i > 0 && ' '}
                    <span class="wo-fit wo-clar" aria-hidden="true" style={`--k:${kClar(line.word)};${clarBox(line.word)}`}><span class="wo-fit-in">{line.letters.map((l) => (l.ink ? <span data-ink={l.ink}><i class="wo-bl" />{l.ch}</span> : <span class="wo-sp" />))}</span></span>
                  </Fragment>
                ))}
              </h1>
              <p class="wo-role">
                <span class="wo-sr">{roleLine}</span>
                <span class="wo-fit wo-goth" aria-hidden="true" style={`--k:${kGoth(roleLine)}`}><span class="wo-fit-in"><span data-ink="pb"><i class="wo-bl" />{roleLine.toUpperCase()}</span></span></span>
              </p>
              <div class="wo-lede">
                <p class="wo-tag">{client.tagline}</p>
                <div class="wo-actions">
                  <a class="wo-btn" href="#talk">Let’s talk</a>
                  <a class="wo-btn wo-btn-open" href="#work">See the {v.workLabel.toLowerCase()}</a>
                </div>
              </div>
            </div>

            <p class="wo-cue" aria-hidden="true">
              <svg viewBox="0 0 12 28"><path d="M6 0v26M1 21l5 5 5-5" /></svg><span>Scroll into the ink</span>
            </p>
          </div>
        </section>
      </div>
    </div>

    <section class="wo-sheet wo-about" id="about" data-sheet="about" aria-labelledby="wo-about-h">
      <canvas class="wo-ink" aria-hidden="true"></canvas>
      <span class="wo-flood" data-ink="p" data-rect aria-hidden="true"></span>
      <div class="wo-sheet-in">
        <h2 class="wo-sr" id="wo-about-h">About {v.firstName}</h2>
        <p class="wo-statement">{words.map((w) => <span class="wo-w">{w} </span>)}</p>
      </div>
    </section>

    {tape.length > 0 && (
      <div class="wo-tape" aria-hidden="true">
        <div class="wo-tape-run">
          {[0, 1, 2, 3].map(() => tape.map((title, i) => <span>{title}<i style={`--c:var(--${BAND_INKS[i % 3]})`} /></span>))}
        </div>
      </div>
    )}

    <section class="wo-sheet wo-record" id="record" data-sheet aria-labelledby="wo-record-h">
      <canvas class="wo-ink" aria-hidden="true"></canvas>
      <div class="wo-sheet-in">
        <h2 class="wo-sr" id="wo-record-h">Record</h2>
        {now.length > 0 && (
          <p class="wo-now">
            <span class="wo-sr">{now[0]}: {now.slice(1).join(', ')}</span>
            {now.map((line, i) => (
              <span class="wo-fit wo-goth" aria-hidden="true" style={`--k:${kGoth(line)}`}><span class="wo-fit-in"><span data-ink={NOW_INKS[i % NOW_INKS.length]}><i class="wo-bl" />{line.toUpperCase()}</span></span></span>
            ))}
          </p>
        )}
        <ol class="wo-years">
          {record.map((r, i) => (
            <li data-rv>
              <span class="wo-num" aria-hidden="true"><span data-ink={YEAR_INKS[i % YEAR_INKS.length]}><i class="wo-bl" />{r.year}</span></span>
              <div class="wo-entry">
                <h3>{r.title}</h3>
                <p>{r.where}</p>
                <p class="wo-label">{r.period}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="wo-sheet wo-work" id="work" data-sheet aria-labelledby="wo-work-h">
      <canvas class="wo-ink" aria-hidden="true"></canvas>
      <div class="wo-sheet-in">
        <h2 class="wo-h2" id="wo-work-h" data-rv>{writer ? 'Selected work' : 'Courses'}</h2>
        {bands.length > 0 && (
          <ul class="wo-bands">
            {bands.map((row, i) => (
              <li class={`wo-band on-${BAND_INKS[i % 3]}`} style={`--rag:${RAG[i % RAG.length]}%`} data-rv>
                <span class="wo-band-ink" data-ink={BAND_INKS[i % 3]} data-rect aria-hidden="true"></span>
                <h3>{row.url ? <a href={row.url}>{row.title}</a> : row.title}</h3>
                <p class="wo-label">{row.meta}</p>
              </li>
            ))}
          </ul>
        )}
        {also.length > 0 && (
          <div class="wo-also" data-rv>
            <h3>{writer ? 'Teaching' : 'Writing'}</h3>
            <ul>
              {also.map((row) => (
                <li>
                  <span class="wo-also-t">{row.url ? <a href={row.url}>{row.title}</a> : row.title}</span>
                  <span class="wo-label">{row.meta}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </section>

    <section class="wo-sheet wo-talk" id="talk" data-sheet aria-labelledby="wo-talk-h">
      <canvas class="wo-ink" aria-hidden="true"></canvas>
      <span class="wo-flood" data-ink="b" data-rect aria-hidden="true"></span>
      <div class="wo-sheet-in">
        <h2 class="wo-talk-h" id="wo-talk-h" aria-label={TALK}>
          {talkLines.map((line, i) => (
            <Fragment>
              {i > 0 && ' '}
              <span class="wo-fit wo-clar" aria-hidden="true" style={`--k:${kClar(line.word)};${clarBox(line.word)}`}><span class="wo-fit-in">{line.letters.map((l) => <span data-ink={l.ink} data-knock="b"><i class="wo-bl" />{l.ch}</span>)}</span></span>
            </Fragment>
          ))}
        </h2>
        {/* [TODO: form endpoint] No form service chosen yet; the form is inert in this demo. */}
        <form class="wo-coupon" data-rv>
          <span class="wo-coupon-paper" data-knock="b" data-rect aria-hidden="true"></span>
          <svg class="wo-scissors" viewBox="0 0 34 20" aria-hidden="true"><circle cx="5.5" cy="5" r="3.5" /><circle cx="5.5" cy="15" r="3.5" /><path d="M8.5 7 33 17M8.5 13 33 3" /></svg>
          <label>Name<input type="text" name="name" autocomplete="name" /></label>
          <label>Email<input type="email" name="email" autocomplete="email" /></label>
          <label class="wo-wide">Message<textarea name="message" rows="3"></textarea></label>
          <button type="button" disabled class="wo-send">Send message</button>
          <p>Demo only. The form is not connected on sample sites.</p>
        </form>
      </div>
    </section>

    <footer class="wo-colophon">
      <span class="wo-swatches" aria-hidden="true">{SWATCHES.map((ink) => <i style={`--c:var(--${ink})`} />)}</span>
      <p>© {new Date().getFullYear()} {client.name}</p>
      <p>Sample site with fictional content, a demo by webdle.</p>
      <p>Set in Besley and League Gothic. Printed in three inks.</p>
    </footer>
  </div>
</Base>

<script>
  import '../scripts/wow';
</script>

<style is:global>
  html[data-direction='wow'] {
    background: #f4f4f0;
    scrollbar-color: #1b1530 #f4f4f0;
  }
  .wo {
    /* Paper, three inks, and the four colours their overprints make. wow-press.ts reads these. */
    --paper: #f4f4f0;
    --y: #ffd21f;
    --p: #ff4577;
    --b: #1a5cf0;
    --yp: #ff5a1f;
    --yb: #14a04e;
    --pb: #2d1e9e;
    --ypb: #1b1530;
    --key: #1b1530;
    --clar: 'Besley Variable', Rockwell, Georgia, serif;
    --goth: 'League Gothic', 'Arial Narrow', sans-serif;
    --pad: clamp(1rem, 3.4vw, 3rem);
    --ease: cubic-bezier(0.16, 1, 0.3, 1);
    /* The measure a fitted line fills. The hero replaces it with a pixel value. */
    --m: 100cqi;
    font-family: var(--clar);
    font-size: 1.0625rem;
    line-height: 1.5;
    color: var(--key);
    background: var(--paper);
    caret-color: var(--p);
    overflow-x: clip;
    -webkit-font-smoothing: antialiased;
  }
  .wo ::selection {
    background: var(--y);
    color: var(--key);
  }
  .wo :focus-visible {
    outline: 3px solid var(--key);
    outline-offset: 3px;
  }
  .wo a {
    text-decoration-thickness: 2px;
    text-underline-offset: 0.18em;
  }
  .wo-band a,
  .wo-also a {
    text-decoration-line: underline;
  }
  .wo-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* ---- sheets and ink ---- */
  .wo-sheet {
    position: relative;
    isolation: isolate;
    background: var(--paper);
  }
  .wo-sheet-in {
    position: relative;
    container-type: inline-size;
    padding-inline: var(--pad);
  }
  .wo-ink {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    display: none;
    pointer-events: none;
  }
  .wo.is-press .wo-ink {
    display: block;
  }
  .wo-flood {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .wo [data-ink='y'] { --c: var(--y); }
  .wo [data-ink='p'] { --c: var(--p); }
  .wo [data-ink='b'] { --c: var(--b); }
  .wo [data-ink='yp'] { --c: var(--yp); }
  .wo [data-ink='yb'] { --c: var(--yb); }
  .wo [data-ink='pb'] { --c: var(--pb); }
  .wo [data-ink='ypb'] { --c: var(--ypb); }
  .wo [data-ink] {
    color: var(--c);
    mix-blend-mode: multiply;
  }
  .wo [data-rect][data-ink] {
    background: var(--c);
  }
  .wo [data-knock],
  .wo .wo-flood {
    /* A flood sits on its section's own colour; multiplying the two would darken it. */
    mix-blend-mode: normal;
  }
  .wo-coupon-paper {
    background: var(--paper);
  }
  /* With the press running, the canvas carries the ink and the elements only hold its place. */
  .wo-js .wo [data-ink],
  .wo-js .wo [data-knock] {
    color: transparent;
    background: none;
    mix-blend-mode: normal;
  }
  .wo-bl {
    display: inline-block;
    width: 0;
    height: 0;
  }
  /* A word space inside a fitted line (a name with more than two parts). */
  .wo-sp {
    display: inline-block;
    width: 0.3em;
  }

  /* ---- fitted poster lines: font-size is a fraction (--k) of the measure ---- */
  .wo-fit {
    display: block;
    position: relative;
    font-size: calc(var(--m) * min(var(--k), var(--kmax, 1)));
    height: calc((var(--asc) + var(--desc)) * 1em);
  }
  .wo-fit-in {
    position: absolute;
    left: 0;
    top: calc((var(--asc) - var(--base)) * 1em);
    display: block;
    line-height: 1;
    white-space: nowrap;
    /* The glyphs' line boxes reach well past their ink; they must not swallow clicks meant for
       the controls they overlap. */
    pointer-events: none;
  }
  .wo-clar {
    --asc: 0.76;
    --desc: 0.02;
    --base: 0.91;
    font-family: var(--clar);
    font-weight: 900;
    /* Tight enough that neighbouring letters overprint where they meet. */
    letter-spacing: -0.085em;
  }
  .wo-goth {
    --asc: 0.75;
    --desc: 0.01;
    --base: 0.87;
    --kmax: 0.34;
    font-family: var(--goth);
    font-weight: 400;
  }

  /* ---- fixed nav: paper tickets with an ink chip ---- */
  .wo-nav {
    position: fixed;
    z-index: 40;
    inset: 0.75rem var(--pad) auto;
    display: flex;
    justify-content: space-between;
    align-items: start;
    gap: 0.5rem;
    pointer-events: none;
    font: 400 1.0625rem / 1 var(--goth);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .wo-nav ul {
    display: flex;
    gap: 0.3rem;
    margin-left: auto;
  }
  .wo-nav a {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    padding: 0.52em 0.7em 0.42em;
    border: 1.5px solid var(--key);
    background: var(--paper);
    color: var(--key);
    text-decoration: none;
    transition: background 0.2s, color 0.2s;
  }
  .wo-nav i {
    width: 0.72em;
    height: 0.72em;
    margin-top: -0.1em;
    background: var(--c);
    transition: rotate 0.5s var(--ease), scale 0.5s var(--ease);
  }
  .wo-nav a:hover i {
    rotate: 135deg;
    scale: 1.2;
  }
  .wo-nav a:hover,
  .wo-nav a[aria-current='true'] {
    background: var(--key);
    color: var(--paper);
  }
  .wo-nav a:focus-visible {
    outline-offset: 2px;
    box-shadow: 0 0 0 7px var(--paper);
  }
  .wo-nav-home {
    visibility: hidden;
    opacity: 0;
    transition: opacity 0.3s, visibility 0.3s, background 0.2s, color 0.2s !important;
  }
  .wo.is-past .wo-nav-home {
    visibility: visible;
    opacity: 1;
  }

  /* ---- hero: the broadside ---- */
  .wo-hero {
    min-height: 100svh;
    display: grid;
  }
  .wo-hero-body {
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    padding: 0.75rem var(--pad) clamp(1rem, 2.4vw, 1.75rem);
    min-width: 0;
  }
  .wo-top {
    flex: none;
    display: flex;
    align-items: center;
    gap: 0.9rem;
    height: 2.3rem;
  }
  .wo-marks {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }
  .wo-swatches {
    display: flex;
    gap: 0.3rem;
  }
  .wo-swatches i {
    width: 1.05rem;
    height: 1.05rem;
  }
  .wo-pull {
    padding: 0.52em 0.7em 0.42em;
    border: 1.5px solid var(--key);
    border-radius: 0;
    background: var(--paper);
    color: var(--key);
    font: 400 1.0625rem / 1 var(--goth);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }
  .wo-pull:hover {
    background: var(--key);
    color: var(--paper);
  }
  .wo-pull:active {
    translate: 0 1px;
  }
  .wo-target {
    width: 1.5rem;
    height: 1.5rem;
    fill: none;
    stroke: var(--key);
    stroke-width: 1;
  }
  .wo-poster {
    position: relative;
    width: var(--m);
    margin-block: auto;
    padding-block: clamp(0.75rem, 2vw, 1.5rem);
  }
  /* The lines kiss: ascenders of one overprint the feet of the last. */
  .wo-name .wo-fit + .wo-fit {
    margin-top: calc(var(--m) * -0.014);
  }
  .wo-role {
    margin-top: calc(var(--m) * 0.024);
  }
  .wo-role .wo-goth {
    --kmax: 0.16;
  }
  .wo-lede {
    width: min(100cqi, 38rem);
    margin-top: clamp(1.25rem, 3vw, 2rem);
  }
  .wo-tag {
    font-size: clamp(1.25rem, 1rem + 1vw, 1.7rem);
    font-weight: 600;
    line-height: 1.22;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .wo-actions {
    margin-top: clamp(1rem, 2vw, 1.5rem);
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  /* Wide screens: both name lines share one size and the copy sits in the notch beside the shorter. */
  .wo-poster[data-notch] .wo-name .wo-fit {
    font-size: calc(var(--m) * var(--kname));
  }
  .wo-poster[data-notch] .wo-lede {
    position: absolute;
    right: 0;
    top: calc(var(--m) * var(--nt));
    width: calc(var(--m) * var(--nw));
    height: calc(var(--m) * var(--nh));
    margin: 0;
    padding-bottom: calc(var(--m) * 0.034);
    display: grid;
    align-content: end;
  }
  /* Short, wide screens: the name is as tall as the screen allows and the copy stands beside it. */
  .wo-poster[data-beside] .wo-lede {
    position: absolute;
    left: calc(var(--m) + var(--bg));
    bottom: clamp(0.75rem, 2vw, 1.5rem);
    width: var(--bw);
    margin: 0;
  }
  .wo-poster[data-tight] .wo-tag {
    font-size: clamp(1.1rem, 0.9rem + 0.45vw, 1.3rem);
    line-height: 1.25;
  }
  .wo-poster[data-tight] .wo-actions {
    margin-top: 0.85rem;
  }
