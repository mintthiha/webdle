  .wm-where {
    margin: 0;
    font-size: 1rem;
  }

  /* ---- work ---- */
  .wm-work {
    background: var(--coral);
  }
  .wm-shelf {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }
  .wm-shelf li {
    transform: rotate(var(--r));
    transition: transform 0.6s var(--ease);
  }
  .wm-shelf li:hover {
    transform: rotate(0deg) translateY(-6px);
  }
  .wm-item {
    aspect-ratio: 1;
    border: 3px solid var(--plum);
    border-radius: 1.75rem;
    overflow: hidden;
    background: var(--art-bg);
    box-shadow: 6px 7px 0 var(--plum);
  }
  .wm-item.wm-cover {
    aspect-ratio: 5 / 7;
    background: var(--cv-bg);
  }
  .wm-item-title {
    margin: 1.1rem 0 0.1rem;
    font-family: 'Bricolage Grotesque Variable', sans-serif;
    font-weight: 800;
    font-size: 1.45rem;
    line-height: 1.15;
  }
  .wm-item-meta {
    margin: 0;
    font-size: 1rem;
  }

  /* ---- gallery ---- */
  .wm-gallery {
    background: var(--paper);
    padding: clamp(3rem, 7vw, 5rem) 0;
    overflow: hidden;
  }
  .wm-gallery ul {
    list-style: none;
    margin: 0;
    padding: 0 clamp(1.25rem, 4vw, 3rem);
    display: flex;
    align-items: center;
    gap: 1.5rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .wm-gallery li {
    flex: 0 0 clamp(14rem, 26vw, 22rem);
    scroll-snap-align: center;
  }
  .wm-gallery li > div {
    border: 3px solid var(--plum);
    border-radius: 2rem;
    overflow: hidden;
    background: var(--art-bg);
    box-shadow: 6px 7px 0 var(--plum);
  }
  .wm-gallery li:nth-child(odd) > div {
    aspect-ratio: 1;
  }
  .wm-gallery li:nth-child(even) > div {
    aspect-ratio: 4 / 5;
    transform: translateY(1.25rem) rotate(1.5deg);
  }

  /* ---- hello ---- */
  .wm-hello-sec {
    background: var(--plum);
    color: var(--paper);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
    max-width: none;
  }
  .wm-hello-sec > * {
    width: 100%;
  }
  .wm-hello-copy {
    justify-self: end;
  }
  .wm-hello-copy h2 {
    font-size: clamp(3rem, 8vw, 5.5rem);
    color: var(--sun);
  }
  .wm-hello-copy .wm-burst {
    margin-left: 0.12em;
    vertical-align: -0.02em;
  }
  .wm-hello-copy p {
    margin: 1.5rem 0 0;
    max-width: 26ch;
    font-size: 1.35rem;
  }
  .wm-form {
    display: grid;
    gap: 1.25rem;
    justify-self: start;
    max-width: 34rem;
  }
  .wm-form label {
    display: grid;
    gap: 0.4rem;
    font-weight: 600;
    font-family: 'Bricolage Grotesque Variable', sans-serif;
  }
  .wm-form input,
  .wm-form textarea {
    border: 3px solid var(--sun);
    background: var(--plum);
    color: var(--paper);
    caret-color: var(--coral);
    padding: 0.85rem 1.1rem;
    border-radius: 1.25rem;
    font: inherit;
    font-family: 'Literata Variable', serif;
    transition: border-color 0.3s var(--ease), background-color 0.3s var(--ease);
  }
  .wm-form input:hover,
  .wm-form textarea:hover {
    background: oklch(0.31 0.085 335);
  }
  /* On the plum ground a plum ring would not show. */
  .wm-form input:focus-visible,
  .wm-form textarea:focus-visible {
    outline-color: var(--coral);
    border-color: var(--paper);
  }
  .wm-form button {
    justify-self: start;
    padding: 0.95rem 1.8rem;
    border-radius: 999px;
    border: 3px solid var(--sun);
