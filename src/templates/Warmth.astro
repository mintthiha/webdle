---
import '@fontsource-variable/bricolage-grotesque/standard.css';
import '@fontsource-variable/literata/wght.css';
import '@fontsource-variable/literata/wght-italic.css';
import Base from '../layouts/Base.astro';
import { collage, cover } from '../lib/art';
import { toView } from '../lib/view';
import type { Client } from '../schemas/client';

interface Props {
  client: Client;
}
const { client } = Astro.props;
const v = toView(client);
const s = client.slug;

/** Palette for the collage art. Each tile uses one colour as ground and the rest as shapes. */
const palette = [
  'oklch(0.9 0.17 95)', // sun
  'oklch(0.3 0.09 335)', // plum
  'oklch(0.74 0.16 35)', // coral
  'oklch(0.9 0.08 165)', // mint
  'oklch(0.84 0.09 305)', // lilac
  'oklch(0.99 0.005 95)', // paper white
];
function tileVars(i: number) {
  const bg = palette[i % palette.length];
  const rest = palette.filter((c) => c !== bg);
  const rot = rest.slice(i % rest.length).concat(rest.slice(0, i % rest.length));
  return `--art-bg:${bg};` + rot.map((c, n) => `--art-${n + 1}:${c}`).join(';');
}

const heroArt = collage({ seed: `${s}-wm-hero`, w: 900, h: 900 });
const aboutArt = collage({ seed: `${s}-wm-about`, w: 700, h: 700 });
const gallery = [0, 1, 2, 3, 4].map((i) => collage({ seed: `${s}-wm-g${i}`, w: 600, h: i % 2 ? 760 : 600 }));

const shelf =
  client.archetype === 'writer'
    ? v.publications.map((p, i) => ({
        art: cover({ title: p.title, sub: `${p.venue}, ${p.year}`, seed: `${s}-wm-${p.title}`, kind: (i + 1) % 4 }),
        title: p.title,
        meta: `${v.typeLabel[p.type]} · ${p.venue}, ${p.year}`,
      }))
    : v.courses.slice(0, 6).map((c, i) => ({
        art: collage({ seed: `${s}-wm-c-${c.course}`, w: 600, h: 600 }),
        title: c.course,
        meta: c.institution,
      }));

const marquee = (client.archetype === 'writer' ? v.publications.map((p) => p.title) : v.courses.map((c) => c.course)).slice(0, 6);

const noteColors = ['var(--mint)', 'var(--lilac)', 'var(--coral)', 'var(--sun)', 'var(--paper)'];
const journey = [
  ...v.education.map((c) => ({
    when: String(c.year),
    title: c.degree,
    where: [c.institution, c.location].filter(Boolean).join(', '),
    kind: 'Studied',
  })),
  ...v.roles.map((r) => ({
    when: v.period(r.startYear, r.endYear),
    title: r.role,
    where: [r.institution, r.department].filter(Boolean).join(' · '),
    kind: 'Worked',
  })),
];
const badge = `${v.nowLabel} · ${v.nowLine} · `;
---

<Base client={client} direction="warmth" title={`${client.name} · ${v.role}`} themeColor="#f6d90a">
  <div class="wm">
    <header class="wm-top">
      <a class="wm-logo" href="#top" aria-label={`${client.name}, home`}>
        <span class="wm-blobmark" aria-hidden="true"></span>{v.firstName}
      </a>
      <nav aria-label="Main">
        <ul>
          <li><a href="#about">About</a></li>
          <li><a href="#path">My path</a></li>
          <li><a href="#work">{v.workLabel}</a></li>
          <li><a class="wm-hello" href="#hello">Say hello</a></li>
        </ul>
      </nav>
    </header>

    <section class="wm-hero" id="top">
      <div class="wm-hero-copy">
        <p class="wm-pill">{v.role}{client.location && <> · {client.location}</>}</p>
        <h1>
          <span class="wm-hi">Hi, I'm</span>
          <span class="wm-name">
            {v.firstName}<svg class="wm-squig" viewBox="0 0 300 24" preserveAspectRatio="none" aria-hidden="true">
              <path d="M3 14 C 28 2, 44 24, 72 12 S 120 2, 148 13 S 200 24, 228 11 S 272 3, 297 12" pathLength="1" />
            </svg>
          </span>
        </h1>
        <p class="wm-tagline">{client.tagline}</p>
        <div class="wm-cta">
          <a class="wm-btn" href="#about">Meet {v.firstName}</a>
          <a class="wm-btn wm-btn-ghost" href="#hello">Say hello</a>
        </div>
      </div>

      <div class="wm-hero-art">
        <div class="wm-blob wm-float" style={tileVars(0)} set:html={heroArt} />
        <svg class="wm-badge" viewBox="0 0 200 200" aria-hidden="true">
          <defs><path id="wm-circle" d="M100,100 m-78,0 a78,78 0 1,1 156,0 a78,78 0 1,1 -156,0" /></defs>
          <circle cx="100" cy="100" r="98" class="wm-badge-bg" />
          <text><textPath href="#wm-circle" textLength="484" lengthAdjust="spacing">{badge}</textPath></text>
          <path class="wm-badge-star" d="M100 74 L106 94 L126 100 L106 106 L100 126 L94 106 L74 100 L94 94Z" />
        </svg>
        <p class="wm-sticker wm-sticker-a">{v.firstName} ★</p>
      </div>
    </section>

    <div class="wm-marquee" aria-hidden="true">
      <div class="wm-track">
        {[0, 1].map(() => (
          <ul>
            {marquee.map((m) => <li>{m}<span>✺</span></li>)}
          </ul>
        ))}
      </div>
    </div>

    <section class="wm-about" id="about">
      <div class="wm-about-card wm-rise">
        <h2>A little about me</h2>
        <p>{client.bio}</p>
      </div>
      <div class="wm-about-art wm-rise">
        <div class="wm-tile wm-tilt-r" style={tileVars(3)} set:html={aboutArt} />
        <p class="wm-sticker wm-sticker-b">{v.nowLabel}: {v.nowLine}</p>
      </div>
    </section>

    <section class="wm-path" id="path">
      <h2 class="wm-rise">My path so far</h2>
      <ul class="wm-notes">
        {journey.map((j, i) => (
          <li class="wm-note wm-rise" style={`--note:${noteColors[i % noteColors.length]};--r:${i % 2 ? 1.4 : -1.2}deg`}>
            <p class="wm-when">{j.when}</p>
            <h3>{j.title}</h3>
            <p class="wm-where">{j.where}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="wm-work" id="work">
      <h2 class="wm-rise">{client.archetype === 'teacher' ? 'What I teach' : 'What I have written'}</h2>
      <ul class="wm-shelf">
        {shelf.map((item, i) => (
          <li class="wm-rise" style={`--i:${i};--r:${i % 2 ? 1.6 : -1.6}deg`}>
            <div class:list={['wm-item', client.archetype === 'writer' && 'wm-cover']} style={client.archetype === 'writer' ? `--cv-bg:${palette[(i * 2 + 1) % 6]};--cv-ink:${i % 3 === 1 ? palette[5] : palette[1]};${tileVars(i + 2)}` : tileVars(i + 1)} set:html={item.art} />
            <p class="wm-item-title">{item.title}</p>
            <p class="wm-item-meta">{item.meta}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="wm-gallery" aria-hidden="true">
      <ul>
        {gallery.map((g, i) => (
          <li style={`--i:${i}`}><div style={tileVars(i + 4)} set:html={g} /></li>
        ))}
      </ul>
    </section>

    <section class="wm-hello-sec" id="hello">
      <div class="wm-hello-copy wm-rise">
        <h2>Say hello <span aria-hidden="true">✺</span></h2>
        <p>
          {client.archetype === 'teacher'
            ? 'Want to talk teaching, speaking, or working together? Send me a note.'
            : 'Press, events, rights, or just a hello? Send me a note.'}
        </p>
      </div>
      <!-- [TODO: form endpoint] No form service chosen yet; the form is inert in this demo. -->
      <form class="wm-form wm-rise">
        <label>Your name<input type="text" name="name" autocomplete="name" /></label>
        <label>Your email<input type="email" name="email" autocomplete="email" /></label>
        <label>Your message<textarea name="message" rows="4"></textarea></label>
        <button type="button" disabled>Send it my way</button>
        <p class="wm-note-demo">Demo only. The form is not connected on sample sites.</p>
      </form>
    </section>

    <footer class="wm-foot">
      <span>© {new Date().getFullYear()} {client.name}</span>
      <span>Sample site with fictional content, a demo by webdle.</span>
    </footer>
  </div>
</Base>

<style is:global>
  html[data-direction='warmth'] {
    scroll-behavior: smooth;
    background: oklch(0.9 0.17 95);
  }

  .wm {
    --sun: oklch(0.9 0.17 95);
    --plum: oklch(0.27 0.08 335);
    --coral: oklch(0.74 0.16 35);
    --mint: oklch(0.9 0.08 165);
    --lilac: oklch(0.84 0.09 305);
    --paper: oklch(0.99 0.005 95);
    --ease: cubic-bezier(0.16, 1, 0.3, 1);
    --cv-font: 'Bricolage Grotesque Variable', sans-serif;
    --cv-weight: 700;
    font-family: 'Literata Variable', Georgia, serif;
    font-size: 1.125rem;
    line-height: 1.65;
    color: var(--plum);
    background: var(--sun);
    overflow-x: clip;
  }
  .wm h1,
  .wm h2,
  .wm h3,
  .wm .wm-pill,
  .wm .wm-btn,
  .wm nav,
  .wm .wm-sticker,
  .wm .wm-when {
    font-family: 'Bricolage Grotesque Variable', ui-sans-serif, system-ui, sans-serif;
  }
  .wm h1,
  .wm h2,
  .wm h3 {
    margin: 0;
    font-weight: 800;
    letter-spacing: -0.025em;
    text-wrap: balance;
    line-height: 1.02;
  }
  .wm section[id] {
    scroll-margin-top: 4rem;
  }
  .wm svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .wm a:focus-visible,
  .wm button:focus-visible,
  .wm input:focus-visible,
  .wm textarea:focus-visible {
    outline: 3px solid var(--plum);
    outline-offset: 3px;
  }

  /* ---- nav ---- */
  .wm-top {
    position: sticky;
    top: 0.75rem;
    z-index: 20;
    margin: 0.75rem auto 0;
    width: min(calc(100% - 1.5rem), 72rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.55rem 0.7rem 0.55rem 1.1rem;
    border-radius: 999px;
    background: var(--paper);
    box-shadow: 0 6px 0 var(--plum);
    border: 2px solid var(--plum);
  }
  .wm-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: 'Bricolage Grotesque Variable', sans-serif;
    font-weight: 800;
    font-size: 1.25rem;
    color: var(--plum);
    text-decoration: none;
  }
  .wm-blobmark {
    width: 1.5rem;
    height: 1.5rem;
    background: var(--coral);
    border: 2px solid var(--plum);
    border-radius: 58% 42% 55% 45% / 48% 55% 45% 52%;
  }
  .wm-top ul {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 2vw, 1.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
    font-weight: 600;
    font-size: 1rem;
  }
  .wm-top a {
    color: var(--plum);
    text-decoration: none;
  }
  .wm-top li a:not(.wm-hello):hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }
  .wm-hello {
    background: var(--plum);
    color: var(--paper) !important;
    padding: 0.55rem 1.1rem;
    border-radius: 999px;
    transition: transform 0.4s var(--ease);
  }
  .wm-hello:hover {
    transform: rotate(-3deg) scale(1.05);
  }

  /* ---- hero ---- */
  .wm-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
    max-width: 80rem;
    margin: 0 auto;
    padding: clamp(3rem, 8vw, 6rem) clamp(1.25rem, 4vw, 3rem) clamp(4rem, 9vw, 7rem);
  }
  .wm-pill {
    display: inline-block;
    margin: 0 0 1.5rem;
    padding: 0.4rem 1rem;
    border: 2px solid var(--plum);
    border-radius: 999px;
    background: var(--paper);
    font-weight: 600;
    font-size: 1rem;
    line-height: 1.3;
  }
  .wm-hero h1 {
    font-size: clamp(3.5rem, 11vw, 6rem);
    line-height: 0.95;
    font-stretch: 88%;
  }
  .wm-hi {
    display: block;
    font-weight: 600;
    font-size: 0.5em;
    margin-bottom: 0.15em;
  }
  .wm-name {
    position: relative;
    display: inline-block;
    padding-bottom: 0.12em;
  }
  .wm svg.wm-squig {
    position: absolute;
    left: -2%;
    bottom: -0.1em;
    width: 104%;
    height: 0.3em;
    overflow: visible;
  }
  .wm-squig path {
    fill: none;
    stroke: var(--coral);
    stroke-width: 7;
    stroke-linecap: round;
    stroke-dasharray: 1;
    vector-effect: non-scaling-stroke;
  }
  .wm-tagline {
    margin: 1.75rem 0 0;
    max-width: 30ch;
    font-size: clamp(1.25rem, 2vw, 1.55rem);
    line-height: 1.45;
    font-weight: 450;
  }
  .wm-cta {
    margin-top: 2.25rem;
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .wm-btn {
    display: inline-block;
    padding: 0.95rem 1.7rem;
    border-radius: 999px;
    border: 2px solid var(--plum);
    background: var(--plum);
    color: var(--paper);
    font-weight: 700;
    font-size: 1.05rem;
    text-decoration: none;
    box-shadow: 4px 5px 0 var(--coral);
    transition: transform 0.4s var(--ease), box-shadow 0.4s var(--ease);
  }
  .wm-btn:hover {
    transform: translate(-2px, -2px) rotate(-1.5deg);
    box-shadow: 7px 8px 0 var(--coral);
  }
  .wm-btn-ghost {
    background: var(--paper);
    color: var(--plum);
    box-shadow: 4px 5px 0 var(--plum);
  }

  .wm-hero-art {
    position: relative;
    width: min(100%, 34rem);
    justify-self: center;
  }
  .wm-blob {
    aspect-ratio: 1;
    border: 3px solid var(--plum);
    border-radius: 58% 42% 55% 45% / 48% 55% 45% 52%;
    overflow: hidden;
    background: var(--art-bg);
    box-shadow: 8px 10px 0 var(--plum);
  }
  .wm svg.wm-badge {
    position: absolute;
    right: -1.5rem;
    bottom: -1.75rem;
    width: 8.5rem;
    height: 8.5rem;
  }
  .wm-badge-bg {
    fill: var(--coral);
    stroke: var(--plum);
    stroke-width: 3;
  }
  .wm-badge text {
    font: 700 14.5px 'Bricolage Grotesque Variable', sans-serif;
    fill: var(--plum);
  }
  .wm-badge-star {
    fill: var(--plum);
  }
  .wm-sticker {
    position: absolute;
    margin: 0;
    padding: 0.45rem 1rem;
    background: var(--paper);
    border: 2px solid var(--plum);
    border-radius: 999px;
    font-weight: 700;
    font-size: 1.05rem;
    line-height: 1.25;
    box-shadow: 3px 4px 0 var(--plum);
  }
  .wm-sticker-a {
    left: -1rem;
    top: 12%;
    transform: rotate(-8deg);
    background: var(--mint);
  }
  .wm-sticker-b {
    left: -0.75rem;
    bottom: 8%;
    max-width: 17rem;
    transform: rotate(-4deg);
    background: var(--sun);
    border-radius: 1.25rem;
  }

  /* ---- marquee ---- */
  .wm-marquee {
    background: var(--plum);
    color: var(--sun);
    border-block: 3px solid var(--plum);
    overflow: hidden;
    transform: rotate(-1.2deg);
    margin-inline: -1rem;
  }
  .wm-track {
    display: flex;
    width: max-content;
  }
  .wm-track ul {
    display: flex;
    margin: 0;
    padding: 0.9rem 0;
    list-style: none;
    font-family: 'Bricolage Grotesque Variable', sans-serif;
    font-weight: 800;
    font-size: clamp(1.4rem, 3vw, 2.2rem);
    white-space: nowrap;
  }
  .wm-track li {
    display: inline-flex;
    gap: 1.25rem;
    padding-right: 1.25rem;
    align-items: center;
  }
  .wm-track li span {
    color: var(--coral);
  }

  /* ---- shared section scaffolding ---- */
  .wm-about,
  .wm-path,
  .wm-work,
  .wm-hello-sec {
    padding: clamp(4.5rem, 10vw, 8rem) clamp(1.25rem, 4vw, 3rem);
  }
  .wm-about > *,
  .wm-path > *,
  .wm-work > *,
  .wm-hello-sec > * {
    max-width: 72rem;
  }

  /* ---- about ---- */
  .wm-about {
    background: var(--paper);
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
    max-width: none;
    margin-top: 2.5rem;
  }
  .wm-about > * {
    justify-self: center;
    width: 100%;
  }
  .wm-about-card {
    background: var(--mint);
    border: 3px solid var(--plum);
    border-radius: 2rem;
    padding: clamp(1.75rem, 4vw, 3rem);
    box-shadow: 8px 10px 0 var(--plum);
    transform: rotate(-1deg);
    justify-self: end;
  }
  .wm-about-card h2 {
    font-size: clamp(2rem, 4.5vw, 3.2rem);
    margin-bottom: 1.25rem;
  }
  .wm-about-card p {
    margin: 0;
    font-size: clamp(1.15rem, 1.8vw, 1.35rem);
    line-height: 1.7;
    max-width: 38em;
  }
  .wm-about-art {
    position: relative;
    max-width: 26rem;
    justify-self: start;
  }
  .wm-tile {
    aspect-ratio: 1;
    border: 3px solid var(--plum);
    border-radius: 2rem;
    overflow: hidden;
    background: var(--art-bg);
    box-shadow: 8px 10px 0 var(--plum);
  }
  .wm-tilt-r {
    transform: rotate(3deg);
    transition: transform 0.7s var(--ease);
  }
  .wm-tilt-r:hover {
    transform: rotate(-1deg) scale(1.02);
  }

  /* ---- path ---- */
  .wm-path {
    background: var(--lilac);
    border-block: 3px solid var(--plum);
  }
  .wm-path h2,
  .wm-work h2 {
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    margin: 0 auto 3rem;
  }
  .wm-notes {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1.75rem;
  }
  .wm-note {
    background: var(--note);
    border: 3px solid var(--plum);
    border-radius: 1.5rem;
    padding: 1.5rem 1.5rem 1.75rem;
    box-shadow: 6px 7px 0 var(--plum);
    transform: rotate(var(--r));
    transition: transform 0.6s var(--ease);
  }
  .wm-note:hover {
    transform: rotate(0deg) translateY(-4px);
  }
  .wm-when {
    margin: 0 0 0.75rem;
    font-weight: 800;
    font-size: 1.9rem;
    line-height: 1;
  }
  .wm-note h3 {
    font-size: 1.4rem;
    line-height: 1.15;
    margin-bottom: 0.5rem;
  }
  .wm-where {
    margin: 0;
    font-size: 1rem;
  }

  /* ---- work ---- */
  .wm-work {
    background: var(--coral);
  }
  .wm-shelf {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }
  .wm-shelf li {
    transform: rotate(var(--r));
    transition: transform 0.6s var(--ease);
  }
  .wm-shelf li:hover {
    transform: rotate(0deg) translateY(-6px);
  }
  .wm-item {
    aspect-ratio: 1;
    border: 3px solid var(--plum);
    border-radius: 1.75rem;
    overflow: hidden;
    background: var(--art-bg);
    box-shadow: 6px 7px 0 var(--plum);
  }
  .wm-item.wm-cover {
    aspect-ratio: 5 / 7;
    background: var(--cv-bg);
  }
  .wm-item-title {
    margin: 1.1rem 0 0.1rem;
    font-family: 'Bricolage Grotesque Variable', sans-serif;
    font-weight: 800;
    font-size: 1.45rem;
    line-height: 1.15;
  }
  .wm-item-meta {
    margin: 0;
    font-size: 1rem;
  }

  /* ---- gallery ---- */
  .wm-gallery {
    background: var(--paper);
    padding: clamp(3rem, 7vw, 5rem) 0;
    overflow: hidden;
  }
  .wm-gallery ul {
    list-style: none;
    margin: 0;
    padding: 0 clamp(1.25rem, 4vw, 3rem);
    display: flex;
    align-items: center;
    gap: 1.5rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .wm-gallery li {
    flex: 0 0 clamp(14rem, 26vw, 22rem);
    scroll-snap-align: center;
  }
  .wm-gallery li > div {
    border: 3px solid var(--plum);
    border-radius: 2rem;
    overflow: hidden;
    background: var(--art-bg);
    box-shadow: 6px 7px 0 var(--plum);
  }
  .wm-gallery li:nth-child(odd) > div {
    aspect-ratio: 1;
  }
  .wm-gallery li:nth-child(even) > div {
    aspect-ratio: 4 / 5;
    transform: translateY(1.25rem) rotate(1.5deg);
  }

  /* ---- hello ---- */
  .wm-hello-sec {
    background: var(--plum);
    color: var(--paper);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
