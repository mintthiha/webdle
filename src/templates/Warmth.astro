  @media (max-width: 36rem) {
    .wm-shelf {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 56rem) {
    .wm-shelf {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .wm-hero,
    .wm-about,
    .wm-hello-sec {
      grid-template-columns: 1fr;
    }
    .wm-about-card,
    .wm-hello-copy,
    .wm-about-art,
    .wm-form {
      justify-self: stretch;
    }
    .wm-top ul li:nth-child(-n + 3) {
      display: none;
    }
    .wm-badge {
      right: -0.5rem;
      width: 6.5rem;
      height: 6.5rem;
    }
    .wm-sticker-a {
      left: 0;
    }
  }

  /* ---- motion: enhancements over a fully visible page ---- */
  @media (prefers-reduced-motion: no-preference) {
    html[data-direction='warmth']:not(.lenis) {
      scroll-behavior: smooth;
    }

    /*
     * Arrival: the page is put together like the collage it is. The bar drops in, the name is set
     * down and underlined, the blob lands and its cut-outs are dropped onto it one by one, and the
     * badge and the sticker are pressed on last.
     */
    .wm-top {
      animation: wm-drop 0.8s var(--ease) backwards;
    }
    .wm-pill,
    .wm-hi,
    .wm-tagline,
    .wm-cta .wm-btn {
      animation: wm-pop 0.8s var(--ease) backwards;
    }
    .wm-pill {
      animation-delay: 0.05s;
    }
    .wm-hi {
      animation-delay: 0.12s;
    }
    .wm-name {
      transform-origin: 0 100%;
      animation: wm-set 0.8s var(--press) 0.2s backwards;
    }
    .wm-squig path {
      animation: wm-draw 1s var(--ease) 0.7s backwards;
    }
    .wm-tagline {
      animation-delay: 0.35s;
    }
    .wm-cta .wm-btn {
      animation-delay: 0.45s;
    }
    .wm-cta .wm-btn + .wm-btn {
      animation-delay: 0.53s;
    }
    .wm-blob {
      animation: wm-morph 16s ease-in-out infinite alternate, wm-land 0.9s var(--press) 0.15s backwards;
    }
    /* Once down, the cut-outs never lie quite still. */
    .wm-blob .art-piece {
      animation: wm-piece 0.6s var(--press) calc(0.5s + var(--n) * 60ms) backwards,
        wm-bob calc(7s + var(--n) * 0.9s) ease-in-out calc(var(--n) * -1.7s) infinite alternate;
    }
    .wm-blob .art-piece:nth-child(even) {
      animation-direction: normal, alternate-reverse;
    }
    .wm-badge {
      animation: wm-spin 28s linear infinite, wm-press 0.7s var(--press) 1.05s backwards;
    }
    .wm-sticker-a {
      animation: wm-slap 0.55s var(--press) 1.35s backwards;
    }
    .wm-blobmark {
      animation: wm-wobble 9s ease-in-out infinite alternate;
    }
    .wm-hello-copy .wm-burst {
      animation: wm-spin 16s linear infinite;
    }
    /* With the script running, a loop rests while it is off screen (src/scripts/warmth.ts). */
    .wm.is-motion .wm-hero-art:not(.is-live) :is(.wm-blob, .wm-badge, .art-piece),
    .wm.is-motion .wm-hello-copy:not(.is-live) .wm-burst {
      animation-play-state: paused;
    }

    /* The tape runs on its own here; with the script running it takes its speed from the scroll. */
    .wm-track {
      animation: wm-scroll 36s linear infinite;
    }
    .wm-marquee:hover .wm-track {
      animation-play-state: paused;
    }
    .wm.is-motion .wm-track {
      animation: none;
    }
    /* The script slides the strip of cut-outs with the page, so it no longer scrolls by hand. */
    .wm.is-motion .wm-gallery ul {
      overflow: visible;
    }

    /* Touch a collage and its pieces shift, the way loose paper does. */
    @media (hover: hover) {
      .wm :is(.wm-tile, .wm-item, .wm-gallery li) .art-piece {
        transition: rotate 0.8s var(--press), scale 0.8s var(--press);
      }
      .wm :is(.wm-tile, .wm-item, .wm-gallery li):hover .art-piece {
        rotate: calc((var(--n) - 4) * 4deg);
        scale: 1.07;
      }
    }

    @keyframes wm-drop {
      from {
        opacity: 0;
        translate: 0 -150%;
      }
    }
    @keyframes wm-pop {
      from {
        opacity: 0;
        translate: 0 22px;
      }
    }
    @keyframes wm-set {
      from {
        opacity: 0;
        scale: 0.82;
        rotate: -5deg;
      }
    }
    @keyframes wm-draw {
      from {
        stroke-dashoffset: 1;
      }
      to {
        stroke-dashoffset: 0;
      }
    }
    /* Paper comes down from above its own shadow. */
    @keyframes wm-land {
      from {
        opacity: 0;
        scale: 1.14;
        box-shadow: 20px 26px 0 var(--plum);
      }
    }
    @keyframes wm-piece {
      from {
        opacity: 0;
        scale: 1.5;
        rotate: 24deg;
      }
    }
    @keyframes wm-bob {
      from {
        translate: -5px 9px;
      }
      to {
        translate: 6px -11px;
      }
    }
    @keyframes wm-press {
      from {
        opacity: 0;
        scale: 1.5;
      }
    }
    @keyframes wm-slap {
      from {
        opacity: 0;
        scale: 1.7;
        rotate: 14deg;
        box-shadow: 14px 18px 0 var(--plum);
      }
    }
    @keyframes wm-morph {
      to {
        border-radius: 42% 58% 46% 54% / 56% 44% 56% 44%;
        rotate: 2deg;
      }
    }
    @keyframes wm-wobble {
      to {
        border-radius: 42% 58% 46% 54% / 56% 44% 56% 44%;
      }
    }
    @keyframes wm-spin {
      to {
        rotate: 360deg;
      }
    }
    @keyframes wm-scroll {
      to {
        transform: translateX(-50%);
      }
    }

    /*
     * Scroll reveals, held back only while html.wm-js says the script is on its way
     * (src/scripts/warmth.ts adds .is-in). Everything is paper being put on the page: cards, notes
     * and tiles come down from above their own shadow and are pressed flat, a sticker is slapped
     * on after them, and a heading is set down a word at a time.
     */
    .wm-js .wm [data-rv] {
      --dl: calc(var(--d, 0) * 100ms);
    }
    .wm-js .wm [data-rv='stick'] {
      transition: opacity 0.45s ease-out var(--dl), scale 0.9s var(--press) var(--dl),
        rotate 0.9s var(--press) var(--dl), box-shadow 0.9s var(--ease) var(--dl), transform 0.6s var(--ease);
    }
    .wm-js .wm [data-rv='stick'] > .wm-item {
      transition: box-shadow 0.9s var(--ease) var(--dl);
    }
    .wm-js .wm [data-rv='stick']:not(.is-in) {
      opacity: 0;
      scale: 1.16;
      rotate: calc(var(--r, 1deg) * 5);
    }
    .wm-js .wm :is(.wm-about-card, .wm-tile, .wm-note)[data-rv='stick']:not(.is-in),
    .wm-js .wm [data-rv='stick']:not(.is-in) > .wm-item {
      box-shadow: 18px 22px 0 var(--plum);
    }
    .wm-js .wm [data-rv='slap'] {
      --sd: calc(var(--dl) + 0.35s);
      transition: opacity 0.2s ease-out var(--sd), scale 0.55s var(--press) var(--sd),
        rotate 0.55s var(--press) var(--sd), box-shadow 0.55s var(--ease) var(--sd);
    }
    .wm-js .wm [data-rv='slap']:not(.is-in) {
      opacity: 0;
      scale: 1.7;
      rotate: 14deg;
      box-shadow: 14px 18px 0 var(--plum);
    }
    .wm-js .wm [data-rv='words'] :is(.wm-w, .wm-burst) {
      --wd: calc(var(--dl) + var(--w, 3) * 80ms);
      transition: opacity 0.3s ease-out var(--wd), translate 0.7s var(--press) var(--wd),
        rotate 0.7s var(--press) var(--wd), scale 0.7s var(--press) var(--wd);
    }
    .wm-js .wm [data-rv='words']:not(.is-in) .wm-w {
      opacity: 0;
      translate: 0 0.55em;
      rotate: 7deg;
    }
    .wm-js .wm [data-rv='words']:not(.is-in) .wm-w:nth-child(even) {
      rotate: -7deg;
    }
    .wm-js .wm [data-rv='words']:not(.is-in) .wm-burst {
      opacity: 0;
      scale: 0;
    }
    .wm-js .wm [data-rv='rise'] {
      transition: opacity 0.7s var(--ease) var(--dl), translate 0.9s var(--ease) var(--dl);
    }
    .wm-js .wm [data-rv='rise']:not(.is-in) {
      opacity: 0;
      translate: 0 1.5rem;
    }
  }
</style>
