---
import '@fontsource-variable/alegreya/wght.css';
import '@fontsource-variable/alegreya/wght-italic.css';
import Base from '../layouts/Base.astro';
import { cover, landscape, marble, rosette } from '../lib/art';
import { toView, type ClassicPage } from '../lib/view';
import type { Client } from '../schemas/client';

interface Props {
  client: Client;
  page: ClassicPage;
}
const { client, page } = Astro.props;
const v = toView(client);
const s = client.slug;
const teacher = client.archetype === 'teacher';

const base = `/classic/${s}/`;
const nav = [
  { page: 'home', href: base, label: 'Home' },
  { page: 'about', href: `${base}about/`, label: 'About' },
  { page: 'work', href: `${base}work/`, label: v.workLabel },
  { page: 'contact', href: `${base}contact/`, label: 'Contact' },
];
const titles = { home: v.role, about: 'About', work: v.workLabel, contact: 'Contact' };

/** The endpaper: cream and sage grounds, veined in the page's own cloth green and gilt (--pine, --gilt). */
const endpaper = marble({
  seed: `${s}-cl-${page}`,
  grounds: ['#efe8d6', '#e3ead9', '#c9d9c9', '#a9c3ae', '#f5f0e2'],
  veins: ['#2f5a48', '#d9a441', '#1d3b31', '#8fae98'],
});
/** A plate stands where a photograph of the person would: a view, mounted and framed. */
const plate = (name: string, w: number, h: number) =>
  landscape({ seed: `${s}-cl-${page}-${name}`, motif: v.motif, layers: 7, w, h, sunSize: 0.1 });

/** Cover cloths, each with the ink that reads on it. */
const cloths = [
  ['#efe8d6', '#1d3b31'],
  ['#2f5a48', '#f5f0e2'],
  ['#dfe9df', '#1d3b31'],
];
const pubs = v.publications.map((p, i) => ({
  ...p,
  art: cover({ title: p.title, sub: `${p.venue}, ${p.year}`, seed: `${s}-cl-${p.title}`, kind: (i + 1) % 4 }),
  cloth: `--cv-bg:${cloths[i % 3][0]};--cv-ink:${cloths[i % 3][1]}`,
  meta: `${v.typeLabel[p.type]} · ${p.venue}, ${p.year}`,
}));
const seal = rosette({ seed: `${s}-cl-seal`, rings: 30 });
const record = v.education.length > 0 || v.roles.length > 0;
---

<Base client={client} direction="classic" title={`${client.name} · ${titles[page]}`} themeColor="#2f5a48">
  <script is:inline>
    // Hold the scroll reveals back until the script arrives; give the page back if it never does.
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.documentElement.classList.add('cl-js');
      setTimeout(function () {
        if (!document.querySelector('.cl.is-ready')) document.documentElement.classList.remove('cl-js');
      }, 5000);
    }
    // Going to another page of this site: say so, so both pages keep the header still and turn only
    // what is under it (the vt-turn rules below; Base.astro reads the note on arrival).
    document.addEventListener('click', function (e) {
      var a = e.target.closest ? e.target.closest('a[data-turn]') : null;
      if (!a || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      try {
        sessionStorage.setItem('webdle-turn', String(Date.now()));
      } catch (err) {}
      document.documentElement.classList.add('vt-turn');
    });
    addEventListener('pageshow', function (e) {
      if (e.persisted) document.documentElement.classList.remove('vt-turn');
    });
  </script>

  <div class="cl" data-page={page}>
    <header class="cl-top">
      <a class="cl-brand" href={base} data-turn>
        <span class="cl-brand-name">{client.name}</span>
        <span class="cl-brand-line">{v.role}{client.location && <> · {client.location}</>}</span>
      </a>
      <nav aria-label="Main">
        <ul>
          {nav.map((n) => (
            <li>
              <a href={n.href} data-turn aria-current={n.page === page ? 'page' : undefined}>
                {n.label}
                {n.page === page && <span class="cl-mark" />}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </header>

    <main class="cl-main">
      {page === 'home' && (
        <>
          <section class="cl-hero">
            <div class="cl-band">
              <div class="cl-paper" aria-hidden="true" set:html={endpaper} />
              <div class="cl-wrap">
                <div class="cl-card">
                  <h1>{client.name}</h1>
                  <p>{v.role}{client.location && <> · {client.location}</>}</p>
                </div>
              </div>
            </div>
            <div class="cl-field">
              <div class="cl-wrap">
                <div class="cl-plate cl-plate-hero" aria-hidden="true" set:html={plate('a', 640, 900)} />
                <div class="cl-lead">
                  <p class="cl-lead-text">{client.tagline}</p>
                  <p class="cl-now"><span>{v.nowLabel}</span> {v.nowLine}</p>
                  <p class="cl-actions">
                    <a class="cl-btn cl-btn-gilt" href={`${base}about/`} data-turn>More about {v.firstName}</a>
                    <a class="cl-link" href={`${base}contact/`} data-turn>Get in touch</a>
                  </p>
                </div>
              </div>
            </div>
          </section>

          <section class="cl-section cl-teaser">
            <div class="cl-wrap">
              <div class="cl-teaser-head">
                <h2 data-rv="up">{teacher ? <>What <strong>I teach</strong></> : <>Selected <strong>writing</strong></>}</h2>
                <a class="cl-more" href={`${base}work/`} data-turn data-rv="rise">
                  All {v.workLabel.toLowerCase()}
                  <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M2.5 8h11M9 3.5 13.5 8 9 12.5" /></svg>
                </a>
              </div>
              {teacher ? (
                <ul class="cl-courses-grid">
                  {v.courses.slice(0, 6).map((c) => (
                    <li data-rv="row">
                      <strong>{c.course}</strong>
                      <span>{c.institution}</span>
                    </li>
                  ))}
                </ul>
              ) : (
                <ul class="cl-shelf">
                  {pubs.slice(0, 3).map((p) => (
                    <li data-rv="rise">
                      <div class="cl-cover" style={p.cloth} aria-hidden="true" set:html={p.art} />
                      <strong>{p.title}</strong>
                      <span>{p.meta}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </section>
        </>
      )}

      {page === 'about' && (
        <>
          <section class="cl-about">
            <div class="cl-about-art" aria-hidden="true">
              <div class="cl-paper" set:html={endpaper} />
              <div class="cl-plate" data-rv="plate" set:html={plate('a', 640, 860)} />
            </div>
            <div class="cl-about-copy">
              <h1 data-rv="up">Bio <strong>and credentials</strong></h1>
              <p class="cl-bio" data-rv="rise">{client.bio}</p>
              <p class="cl-now cl-now-ink" data-rv="rise"><span>{v.nowLabel}</span> {v.nowLine}</p>
            </div>
          </section>

          {record && (
            <section class="cl-section cl-record">
              <div class="cl-wrap cl-record-grid">
                <div>
                  <h2 data-rv="up">
                    {v.education.length > 0 && v.roles.length > 0 ? (
                      <>Education <strong>and teaching</strong></>
                    ) : v.education.length > 0 ? (
                      'Education'
                    ) : (
                      'Teaching'
                    )}
                  </h2>
                  {v.education.length > 0 && (
                    <details class="cl-box" open data-rv="rise">
                      <summary><span class="cl-sign" aria-hidden="true" />Education</summary>
                      <ul>
                        {v.education.map((c) => (
                          <li>
                            <strong>{c.year} – {c.degree}</strong>, {[c.institution, c.location].filter(Boolean).join(', ')}
                          </li>
                        ))}
                      </ul>
                    </details>
                  )}
                  {v.roles.length > 0 && (
                    <details class="cl-box" open data-rv="rise">
                      <summary><span class="cl-sign" aria-hidden="true" />Teaching</summary>
                      {v.roles.map((r) => (
                        <div class="cl-role">
                          <p>
                            <strong>{v.period(r.startYear, r.endYear)} – {r.role}</strong>, {[r.institution, r.department].filter(Boolean).join(', ')}
                          </p>
                          {r.courses.length > 0 && <ul>{r.courses.map((c) => <li>{c}</li>)}</ul>}
                        </div>
                      ))}
                    </details>
                  )}
                </div>
                <div class="cl-record-art" aria-hidden="true">
                  <div class="cl-plate" data-rv="plate" set:html={plate('b', 640, 760)} />
                  <div class="cl-seal" data-rv="plate" set:html={seal} />
                </div>
              </div>
            </section>
          )}
        </>
      )}

      {page === 'work' && (
        <>
          <section class="cl-head">
            <div class="cl-strip" aria-hidden="true"><div class="cl-paper" set:html={endpaper} /></div>
            <div class="cl-wrap">
              <h1 data-rv="up">{teacher ? <>Teaching <strong>and courses</strong></> : <>Selected <strong>writing</strong></>}</h1>
              {teacher && <p data-rv="rise"><span>{v.nowLabel}</span> {v.nowLine}</p>}
            </div>
          </section>

          {!teacher && pubs.length > 0 && (
            <section class="cl-section cl-feature">
              <div class="cl-wrap cl-feature-grid">
                <div class="cl-cover" style={pubs[0].cloth} aria-hidden="true" data-rv="plate" set:html={pubs[0].art} />
                <div>
                  <h2 data-rv="up">{pubs[0].title}</h2>
                  <p class="cl-meta" data-rv="rise">{pubs[0].meta}</p>
                  {pubs[0].url && <a class="cl-btn" href={pubs[0].url} data-rv="rise">Read it</a>}
                </div>
              </div>
            </section>
          )}

          {v.roles.length > 0 && (
            <section class="cl-section cl-posts">
              <div class="cl-wrap">
                {!teacher && <h2 data-rv="up">Teaching</h2>}
                {v.roles.map((r) => (
                  <article class="cl-post" data-rv="row">
                    <p class="cl-post-when">{v.period(r.startYear, r.endYear)}</p>
                    <div>
                      <h3>{r.role}</h3>
                      <p class="cl-meta">{[r.institution, r.department].filter(Boolean).join(' · ')}</p>
                      {r.courses.length > 0 && <ul class="cl-chips">{r.courses.map((c) => <li>{c}</li>)}</ul>}
                    </div>
                  </article>
                ))}
              </div>
            </section>
          )}

          {(teacher ? pubs : pubs.slice(1)).length > 0 && (
            <section class="cl-section cl-also">
              <div class="cl-wrap">
                <h2 data-rv="up">{teacher ? <>Published <strong>writing</strong></> : <>Also <strong>published</strong></>}</h2>
                <ul class="cl-pubs">
                  {(teacher ? pubs : pubs.slice(1)).map((p) => (
                    <li data-rv="row">
                      <div class="cl-cover" style={p.cloth} aria-hidden="true" set:html={p.art} />
                      <div>
                        {p.url ? <a href={p.url}><strong>{p.title}</strong></a> : <strong>{p.title}</strong>}
                        <span>{p.meta}</span>
                      </div>
                    </li>
                  ))}
                </ul>
              </div>
            </section>
          )}
        </>
      )}

      {page === 'contact' && (
        <>
          <section class="cl-head cl-head-center">
            <div class="cl-strip" aria-hidden="true"><div class="cl-paper" set:html={endpaper} /></div>
            <div class="cl-wrap">
              <h1 data-rv="up">Get <strong>in touch</strong></h1>
              <p data-rv="rise">
                {teacher
                  ? 'For speaking, consulting and collaboration, write here.'
                  : 'For press, events and rights enquiries, write here.'}
              </p>
            </div>
          </section>
          <section class="cl-section cl-contact">
            <div class="cl-wrap cl-contact-grid">
              <div class="cl-plate" aria-hidden="true" data-rv="plate" set:html={plate('a', 640, 800)} />
              {/* [TODO: form endpoint] No form service chosen yet; the form is inert in this demo. */}
              <form class="cl-form">
                <label data-rv="rise">Name<input type="text" name="name" autocomplete="name" /></label>
                <label data-rv="rise">Email<input type="email" name="email" autocomplete="email" /></label>
                <label data-rv="rise">Message<textarea name="message" rows="5"></textarea></label>
                <div class="cl-send" data-rv="rise">
                  <button type="button" disabled>Send message</button>
                  <p>Demo only. The form is not connected on sample sites.</p>
                </div>
              </form>
            </div>
          </section>
        </>
      )}
    </main>

    <footer class="cl-foot">
      <nav aria-label="Footer">
        <ul>
          {nav.map((n) => <li><a href={n.href} data-turn>{n.label}</a></li>)}
        </ul>
      </nav>
      <p>
        <span>© {new Date().getFullYear()} {client.name}</span>
        <span>Sample site with fictional content, a demo by webdle.</span>
      </p>
    </footer>
  </div>
</Base>

<script>
  import '../scripts/classic';
</script>

<style is:global>
  html[data-direction='classic'] {
    background: #fffefb;
    scrollbar-color: #2f5a48 #e6eee6;
  }

  .cl {
    --paper: #fffefb;
    --ink: #1a2a24;
    --muted: #4b5f56;
    --pine: #2f5a48;
    --pine-deep: #1d3b31;
    --sage: #e6eee6;
    --gilt: #d9a441;
    --line: #cddacf;
    --ease: cubic-bezier(0.16, 1, 0.3, 1);
    --pad: clamp(1.25rem, 5vw, 4rem);
    --art-sky: #efe8d6;
    --art-sun: #d9a441;
    --art-far: #a9c3ae;
    --art-near: #1d3b31;
    --art-1: #2f5a48;
    --art-2: #d9a441;
    --art-3: #8fae98;
    --art-4: #1d3b31;
    --art-5: #efe8d6;
    --cv-bg: #efe8d6;
    --cv-ink: #1d3b31;
    --cv-font: 'Alegreya Variable', Georgia, serif;
    --cv-weight: 700;
    font-family: 'Alegreya Variable', Georgia, 'Times New Roman', serif;
    font-size: 1.1875rem;
    line-height: 1.6;
    color: var(--ink);
    background: var(--paper);
    caret-color: var(--pine);
    overflow-x: clip;
  }
  .cl ::selection {
    background: var(--pine);
    color: var(--paper);
  }
  .cl svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .cl h1,
  .cl h2,
  .cl h3 {
    margin: 0;
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  /* The one typographic gesture of the site: a heading set light, then bold. */
  .cl h1 strong,
  .cl h2 strong {
    font-weight: 800;
  }
  .cl a:focus-visible,
  .cl button:focus-visible,
  .cl summary:focus-visible,
  .cl input:focus-visible,
  .cl textarea:focus-visible {
    outline: 2px solid var(--pine);
    outline-offset: 3px;
  }
  .cl-wrap {
    position: relative;
    width: min(100% - 2 * var(--pad), 76rem);
    margin-inline: auto;
  }
  .cl-section {
    padding-block: clamp(4rem, 8vw, 7rem);
  }
  .cl h2 {
    font-size: clamp(2.1rem, 4.2vw, 3.4rem);
  }
  .cl-paper {
    position: absolute;
    inset: 0;
  }
  .cl-meta {
    margin: 0.5rem 0 0;
    color: var(--muted);
  }

  /* ---- header: the name, a line under it, and the pages ---- */
  .cl-top {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding: 1.4rem var(--pad) 1.1rem;
    background: var(--paper);
    border-bottom: 1px solid var(--line);
  }
  .cl-brand {
    display: grid;
    color: var(--ink);
    text-decoration: none;
  }
  .cl-brand-name {
    font-size: clamp(1.75rem, 3vw, 2.4rem);
    line-height: 1.1;
  }
  .cl-brand-line {
    font-size: 1.05rem;
    color: var(--muted);
  }
  .cl-top ul,
  .cl-foot ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem clamp(1.1rem, 2.5vw, 2.25rem);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 1.15rem;
  }
  .cl-top nav a {
    position: relative;
    display: block;
    padding: 0.35rem 0;
    color: var(--ink);
    text-decoration: none;
    transition: color 0.3s;
  }
  .cl-top nav a::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 2px;
    background: var(--line);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.5s var(--ease);
  }
  .cl-top nav a:hover,
  .cl-top nav a[aria-current] {
    color: var(--pine);
  }
  .cl-top nav a:hover::after {
    transform: scaleX(1);
  }
  /* The page you are on is marked in gilt; going to another page, the mark travels to it. */
  .cl-mark {
    position: absolute;
    z-index: 1;
    inset: auto 0 0;
    height: 3px;
    border-radius: 2px;
    background: var(--gilt);
  }

  /* ---- buttons and links ---- */
  .cl-btn {
    display: inline-block;
    padding: 0.75rem 1.6rem;
    border-radius: 999px;
    background: var(--pine);
    color: var(--paper);
    font-weight: 700;
    text-decoration: none;
    transition: background-color 0.3s, translate 0.4s var(--ease);
  }
  .cl-btn:hover {
    background: var(--pine-deep);
    translate: 0 -2px;
  }
  .cl-btn:active {
    translate: 0 0;
    transition-duration: 0.1s;
  }
  .cl-btn-gilt {
    background: var(--gilt);
    color: var(--pine-deep);
  }
  .cl-btn-gilt:hover {
    background: #e8b95c;
  }
  .cl-link {
    color: inherit;
    text-decoration-thickness: 1px;
    text-underline-offset: 6px;
    transition: text-underline-offset 0.4s var(--ease);
  }
  .cl-link:hover {
    text-underline-offset: 9px;
  }

  /* ---- plates: a mounted view where a photograph would hang ---- */
  .cl-plate {
    overflow: hidden;
    border: 0.55rem solid var(--paper);
    background: var(--art-sky);
    box-shadow: 0 1px 0 rgb(13 32 25 / 0.1), 0 26px 44px -26px rgb(13 32 25 / 0.7);
  }
  .cl-cover {
    aspect-ratio: 5 / 7;
    box-shadow: 0 1px 0 rgb(13 32 25 / 0.12), 0 22px 40px -22px rgb(13 32 25 / 0.6);
  }

  /* ---- home: endpaper band, name card, then the green field with the plate across both ---- */
  .cl-hero {
    --band-h: clamp(18rem, 36vw, 29rem);
    --field-pad: clamp(3rem, 6vw, 5rem);
  }
  .cl-band {
    position: relative;
    display: grid;
    align-items: center;
    height: var(--band-h);
    overflow: hidden;
  }
  .cl-card {
    width: fit-content;
    max-width: min(100%, 36rem);
    padding: clamp(1.5rem, 3vw, 2.5rem) clamp(1.75rem, 4.5vw, 3.75rem);
    border-radius: 1rem;
    background: color-mix(in oklab, var(--paper) 94%, transparent);
    box-shadow: 0 2px 4px rgb(13 32 25 / 0.08), 0 24px 40px -28px rgb(13 32 25 / 0.7);
    text-align: center;
    color: var(--pine);
  }
  .cl-card h1 {
    font-style: italic;
    font-size: clamp(2.6rem, 6vw, 4.6rem);
  }
  .cl-card p {
    margin: 0.6rem 0 0;
    font-size: clamp(1.2rem, 2vw, 1.6rem);
  }
  .cl-field {
    padding-block: var(--field-pad);
    background: var(--pine);
    color: var(--paper);
  }
  .cl-plate-hero {
    position: absolute;
    right: 0;
    top: calc(-0.62 * var(--band-h) - var(--field-pad));
    bottom: 0;
    width: min(34%, 23rem);
  }
  .cl-lead {
    max-width: calc(100% - min(34%, 23rem) - clamp(2rem, 5vw, 5rem));
    min-height: 15rem;
  }
  .cl-lead-text {
    margin: 0;
    font-size: clamp(1.5rem, 2.7vw, 2.2rem);
    line-height: 1.38;
    text-wrap: pretty;
  }
  .cl-now {
    margin: 1.5rem 0 0;
    font-size: 1.15rem;
    color: #d9e6dc;
  }
  .cl-now span,
  .cl-head p span {
    margin-right: 0.35em;
    font-style: italic;
    color: var(--gilt);
  }
  .cl-now-ink {
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
  }
  .cl-now-ink span,
  .cl-head p span {
    color: var(--pine);
  }
  .cl-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
    margin: 2rem 0 0;
  }

  .cl-teaser-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-bottom: 2.5rem;
  }
  .cl-more {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--pine);
    font-weight: 700;
    text-underline-offset: 6px;
  }
  .cl-more svg {
    flex: none;
    width: 1em;
    height: 1em;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: translate 0.5s var(--ease);
  }
  .cl-more:hover svg {
    translate: 5px 0;
  }
  .cl-courses-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    gap: 0 3rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .cl-courses-grid li,
  .cl-post,
  .cl-pubs li {
    position: relative;
  }
  .cl-courses-grid li::before,
  .cl-post::before,
  .cl-pubs li::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 1px;
    background: var(--line);
    transform-origin: left;
  }
  .cl-courses-grid li {
    display: grid;
    padding: 1.1rem 0 1.4rem;
  }
  .cl-courses-grid strong,
  .cl-shelf strong,
  .cl-pubs strong {
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.25;
