---
interface Props {
  period: string;
  title: string;
  subtitle?: string;
}
const { period, title, subtitle } = Astro.props;
---

<div class="grid gap-1 sm:grid-cols-[9rem_1fr] sm:gap-6 py-4">
  <p class="text-sm text-muted tabular-nums pt-1">{period}</p>
  <div>
    <h3 class="font-semibold text-lg">{title}</h3>
    {subtitle && <p class="text-muted">{subtitle}</p>}
    <slot />
  </div>
</div>
