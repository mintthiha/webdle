---
import { directions, type DirectionSlug } from '../lib/view';
import { getClients } from '../lib/clients';

interface Props {
  clientSlug: string;
  current: DirectionSlug;
}
const { clientSlug, current } = Astro.props;
const others = getClients().filter((c) => c.slug !== clientSlug);
---

<div class="demo-bar">
<a class="demo-home" href="/">← webdle</a>
<details class="demo-switcher">
  <summary>
    <span class="dot" aria-hidden="true"></span>
    Sample site · {directions.find((d) => d.slug === current)?.name}
    <span class="chev" aria-hidden="true">▴</span>
  </summary>
  <div class="panel">
    <p class="label">Same person, other designs</p>
    <ul>
      {directions.map((d) => (
        <li>
          <a href={`/${d.slug}/${clientSlug}/`} aria-current={d.slug === current ? 'page' : undefined}>
            {d.name}
          </a>
        </li>
      ))}
    </ul>
    <p class="label">Other sample person</p>
    <ul>
      {others.map((c) => (
        <li><a href={`/${current}/${c.slug}/`}>{c.name}</a></li>
      ))}
    </ul>
    <a class="all" href="/">← webdle home</a>
  </div>
</details>
</div>

<style>
  .demo-bar {
    position: fixed;
    z-index: 100;
    right: 1rem;
    bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font: 500 0.8125rem/1.3 ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
    color: #fff;
  }
  .demo-home {
    padding: 0.55rem 0.9rem;
    border-radius: 999px;
    background: oklch(0.18 0.01 260 / 0.92);
    backdrop-filter: blur(8px);
    box-shadow: 0 4px 24px oklch(0 0 0 / 0.25);
    color: #fff;
    text-decoration: none;
  }
  .demo-home:hover {
    background: oklch(0.3 0.03 260 / 0.96);
  }
  .demo-home:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }
  .demo-switcher {
    position: relative;
  }
  summary {
    list-style: none;
    cursor: pointer;
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    padding: 0.55rem 0.9rem;
    border-radius: 999px;
    background: oklch(0.18 0.01 260 / 0.92);
    backdrop-filter: blur(8px);
    box-shadow: 0 4px 24px oklch(0 0 0 / 0.25);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:focus-visible,
  a:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }
  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: oklch(0.8 0.17 150);
  }
  .chev {
    font-size: 0.7rem;
  }
  details[open] .chev {
    transform: rotate(180deg);
  }
  .panel {
    margin-bottom: 0.5rem;
    min-width: 14rem;
    padding: 1rem;
    border-radius: 1rem;
    background: oklch(0.18 0.01 260 / 0.96);
    backdrop-filter: blur(8px);
    box-shadow: 0 8px 32px oklch(0 0 0 / 0.3);
    position: absolute;
    bottom: 100%;
    right: 0;
  }
  .label {
    margin: 0 0 0.35rem;
    color: oklch(0.78 0.01 260);
  }
  ul {
    list-style: none;
    margin: 0 0 0.9rem;
    padding: 0;
  }
  li a,
  .all {
    display: block;
    padding: 0.3rem 0;
    color: #fff;
    text-decoration: none;
  }
  li a:hover,
  .all:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  li a[aria-current='page'] {
    color: oklch(0.85 0.14 150);
  }
</style>
