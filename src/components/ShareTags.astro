---
/**
 * What a link to this page looks like when it is pasted into a message, an email or a post
 * (Open Graph and Twitter card). The pictures are made by `npm run og` (scripts/og.mjs).
 * Link previews only follow absolute URLs, so these are complete once `site` is set
 * (astro.config.mjs); until then the addresses stay root-relative and there is no canonical.
 */
interface Props {
  title: string;
  description: string;
  /** File name in public/og/, without the extension. */
  image: string;
  imageAlt: string;
}
const { title, description, image, imageAlt } = Astro.props;
const abs = (p: string) => (Astro.site ? new URL(p, Astro.site).href : p);
---

{Astro.site && <link rel="canonical" href={abs(Astro.url.pathname)} />}
<meta property="og:type" content="website" />
<meta property="og:site_name" content="webdle" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={abs(Astro.url.pathname)} />
<meta property="og:image" content={abs(`/og/${image}.jpg`)} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
<meta name="twitter:card" content="summary_large_image" />
