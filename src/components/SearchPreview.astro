---
/**
 * "How it looks in Google": a button in the demo bar that opens a panel showing the search listing
 * this page sets up for itself, and the facts its JSON-LD gives search engines, worded for a person.
 * It reads the same `searchData` the page head prints, so what it claims is what the page says.
 * It belongs to webdle, not to the sample, so it keeps webdle's neutral look in every design.
 */
import type { Client } from '../schemas/client';
import { searchData } from '../lib/seo';

interface Props {
  client: Client;
  /** The page's <title>. */
  title: string;
  /** The page's address on the client's own site, e.g. "/" or "/about/". */
  path: string;
  /** The page's meta description. */
  description: string;
}
const { client, title, path, description } = Astro.props;
/** Results pages cut long descriptions short at about this length. */
const snippet = description.length > 160 ? `${description.slice(0, 157).replace(/\s+\S*$/, '')} …` : description;
const { jsonLd, facts, host } = searchData(client);
const crumbs = path.split('/').filter(Boolean);
const initials = client.name
  .split(' ')
  .map((w) => w[0])
  .join('')
  .slice(0, 2);
const first = client.name.split(' ')[0];
---

<button class="sp-open" type="button" aria-haspopup="dialog" aria-controls="sp-dialog">
  <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><circle cx="7" cy="7" r="4.5" /><path d="m10.5 10.5 3.5 3.5" /></svg>
  <span class="sp-open-text">In Google</span>
</button>

<dialog id="sp-dialog" class="sp" aria-labelledby="sp-h" data-lenis-prevent>
  <div class="sp-inner">
    <header class="sp-head">
      <div>
        <p class="sp-kicker">Name-search setup</p>
        <h2 id="sp-h">How this site shows up in Google</h2>
      </div>
      <form method="dialog">
        <button class="sp-close" aria-label="Close">
          <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="m3.5 3.5 9 9M12.5 3.5l-9 9" /></svg>
        </button>
      </form>
    </header>

    <section class="sp-sec" aria-labelledby="sp-result-h">
      <h3 id="sp-result-h"><span class="sp-n" aria-hidden="true">1</span>The search result</h3>
      <p class="sp-note">
        When someone searches for {client.name}, this is the listing the site asks for: its own title,
        address and description, written to be clear about who {first} is.
      </p>
      <div class="sp-serp" aria-label="Preview of the search result">
        <div class="sp-query">
          <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><circle cx="7" cy="7" r="4.5" /><path d="m10.5 10.5 3.5 3.5" /></svg>
          <span>{client.name}</span>
        </div>
        <div class="sp-result">
          <div class="sp-site">
            <span class="sp-fav" aria-hidden="true">{initials}</span>
            <span class="sp-site-text">
              <span class="sp-sitename">{client.name}</span>
              <span class="sp-url">https://{host}{crumbs.map((c) => ` › ${c}`).join('')}</span>
            </span>
          </div>
          <p class="sp-title">{title}</p>
          <p class="sp-desc">{snippet}</p>
        </div>
      </div>
    </section>

    <section class="sp-sec" aria-labelledby="sp-facts-h">
      <h3 id="sp-facts-h"><span class="sp-n" aria-hidden="true">2</span>What the page tells search engines</h3>
      <p class="sp-note">
        Out of sight in every page is a short profile written for machines, so a search engine does not
        have to guess which {client.name} this is. In plain words, it says:
      </p>
      <dl class="sp-facts">
        {facts.map((f) => (
          <div>
            <dt>{f.label} <code>{f.prop}</code></dt>
            {f.value.length > 0 ? (
              f.value.map((line) => <dd>{line}</dd>)
            ) : (
              <dd class="sp-empty">None listed yet. Each profile is added once it is checked as really {first}'s.</dd>
            )}
          </div>
        ))}
      </dl>
      <details class="sp-code">
        <summary>Show the code</summary>
        <pre tabindex="0"><code>{JSON.stringify(jsonLd, null, 2)}</code></pre>
      </details>
    </section>

    <footer class="sp-fine">
      <p>
        This is a preview, not a promise. Google chooses the final wording and the order of results,
        so we do not promise rankings or timelines.
      </p>
      <p>
        {first} is a fictional sample, so this demo asks search engines to leave it out. A client's
        own site is open to them.
      </p>
    </footer>
  </div>
</dialog>

<script>
  const dialog = document.getElementById('sp-dialog') as HTMLDialogElement | null;
  const open = document.querySelector<HTMLButtonElement>('.sp-open');
  open?.addEventListener('click', () => dialog?.showModal());
  // A click on the dim backdrop (the dialog element itself, outside its inner panel) closes it.
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
</script>

<style>
  .sp-open {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 0.9rem;
    border: 0;
    border-radius: 999px;
    background: oklch(0.18 0.01 260 / 0.92);
    backdrop-filter: blur(8px);
    box-shadow: 0 4px 24px oklch(0 0 0 / 0.25);
    color: #fff;
    font: inherit;
    cursor: pointer;
  }
  .sp-open:hover {
    background: oklch(0.3 0.03 260 / 0.96);
  }
  .sp-open:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }
  .sp-open svg,
  .sp-query svg {
    width: 0.95rem;
    height: 0.95rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
  }
  /* On a phone the three pills would not fit in a row, so this one keeps just its icon. */
  @media (max-width: 30rem) {
    .sp-open {
      padding-inline: 0.7rem;
    }
    .sp-open-text {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  .sp {
    --sp-ink: oklch(0.2 0.01 260);
    --sp-muted: oklch(0.44 0.01 260);
    --sp-line: oklch(0.9 0.005 260);
    --sp-wash: oklch(0.965 0.004 260);
    --sp-accent: oklch(0.52 0.13 150);
    width: min(40rem, 100% - 2rem);
    max-width: none;
    max-height: min(52rem, 100dvh - 2rem);
    /* Tailwind's reset zeroes every margin; auto is what centres a modal dialog. */
    margin: auto;
    padding: 0;
    border: 0;
    border-radius: 1.25rem;
    background: #fff;
    color: var(--sp-ink);
    box-shadow: 0 24px 64px oklch(0 0 0 / 0.35);
    overflow: auto;
    overscroll-behavior: contain;
    font: 400 0.9375rem/1.55 ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
    text-align: left;
    letter-spacing: normal;
    text-transform: none;
  }
  /* The page behind holds still while the panel is open; the gutter keeps it from shifting sideways. */
  :global(html:has(.sp[open])) {
    overflow: hidden;
    scrollbar-gutter: stable;
  }
  .sp::backdrop {
    background: oklch(0.15 0.01 260 / 0.55);
    backdrop-filter: blur(3px);
  }
  @media (prefers-reduced-motion: no-preference) {
    .sp[open] {
      animation: sp-in 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    .sp[open]::backdrop {
      animation: sp-fade 0.4s ease-out;
    }
  }
  @keyframes sp-in {
    from {
      opacity: 0;
      transform: translateY(1rem) scale(0.98);
    }
  }
  @keyframes sp-fade {
    from {
      opacity: 0;
    }
  }

  .sp-inner {
    padding: 1.5rem;
  }
  @media (min-width: 36rem) {
    .sp-inner {
      padding: 2rem;
    }
  }
  .sp-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .sp-kicker {
    margin: 0 0 0.25rem;
    color: var(--sp-accent);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .sp h2 {
    margin: 0;
    font-size: 1.4rem;
    font-weight: 650;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  .sp-close {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    margin: -0.25rem -0.25rem 0 0;
    border: 0;
    border-radius: 50%;
    background: var(--sp-wash);
    color: var(--sp-ink);
    cursor: pointer;
  }
  .sp-close:hover {
    background: var(--sp-line);
  }
  .sp-close svg {
    width: 0.9rem;
    height: 0.9rem;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
  }
  .sp :is(button, summary, pre):focus-visible {
    outline: 2px solid var(--sp-accent);
    outline-offset: 2px;
  }

  .sp-sec + .sp-sec {
    margin-top: 2rem;
  }
  .sp h3 {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 0.4rem;
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .sp-n {
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    background: var(--sp-ink);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 600;
  }
  .sp-note {
    margin: 0 0 1rem;
    color: var(--sp-muted);
  }

  /* The search result is drawn in the familiar shape of a results page, without anyone's logo. */
  .sp-serp {
    padding: 1rem;
    border: 1px solid var(--sp-line);
    border-radius: 1rem;
    background: #fff;
    font-family: Arial, ui-sans-serif, system-ui, sans-serif;
  }
  .sp-query {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 1rem;
    margin-bottom: 1.1rem;
    border: 1px solid var(--sp-line);
    border-radius: 999px;
    box-shadow: 0 1px 6px oklch(0.3 0.01 260 / 0.12);
    color: #202124;
  }
  .sp-query svg {
    color: #5f6368;
  }
  .sp-site {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-bottom: 0.3rem;
  }
  .sp-fav {
    display: grid;
    place-items: center;
    flex: none;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: var(--sp-wash);
    border: 1px solid var(--sp-line);
    color: #202124;
    font-size: 0.65rem;
    font-weight: 700;
  }
  .sp-site-text {
    display: grid;
    min-width: 0;
    line-height: 1.3;
  }
  .sp-sitename {
    color: #202124;
    font-size: 0.875rem;
  }
  .sp-url {
    overflow: hidden;
    color: #4d5156;
    font-size: 0.75rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .sp-title {
    margin: 0 0 0.25rem;
    color: #1a0dab;
    font-size: 1.25rem;
    line-height: 1.3;
  }
  .sp-desc {
    margin: 0;
    color: #474747;
    font-size: 0.875rem;
    line-height: 1.58;
  }

  .sp-facts {
    margin: 0;
    border-top: 1px solid var(--sp-line);
  }
  .sp-facts > div {
    display: grid;
    gap: 0 1.5rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--sp-line);
  }
  .sp-facts dt {
    margin-bottom: 0.15rem;
    color: var(--sp-muted);
    font-size: 0.875rem;
  }
  /* Wider: the label sits beside its values, however many lines they run to. */
  @media (min-width: 36rem) {
    .sp-facts > div {
      grid-template-columns: 11rem 1fr;
    }
    .sp-facts dt {
      grid-row: span 99;
      margin-bottom: 0;
    }
    .sp-facts dd {
      grid-column: 2;
    }
  }
  .sp-facts code {
    display: inline-block;
    margin-left: 0.3rem;
    padding: 0 0.35rem;
    border-radius: 0.3rem;
    background: var(--sp-wash);
    color: var(--sp-muted);
    font: 0.72rem/1.5 ui-monospace, 'Cascadia Mono', Consolas, monospace;
  }
  .sp-facts dd {
    margin: 0;
  }
  .sp-facts dd + dd {
    margin-top: 0.2rem;
  }
  .sp-facts .sp-empty {
    color: var(--sp-muted);
    font-style: italic;
  }

  .sp-code {
    margin-top: 1rem;
  }
  .sp-code summary {
    display: inline-block;
    color: var(--sp-ink);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--sp-line);
    text-underline-offset: 4px;
    cursor: pointer;
  }
  .sp-code summary:hover {
    text-decoration-color: currentColor;
  }
  .sp-code pre {
    max-height: 20rem;
    margin: 0.75rem 0 0;
    padding: 1rem;
    overflow: auto;
    border-radius: 0.75rem;
    background: oklch(0.2 0.01 260);
    color: oklch(0.92 0.01 260);
    font: 0.78rem/1.55 ui-monospace, 'Cascadia Mono', Consolas, monospace;
    white-space: pre;
  }

  .sp-fine {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--sp-line);
    color: var(--sp-muted);
    font-size: 0.8125rem;
  }
  .sp-fine p {
    margin: 0;
  }
  .sp-fine p + p {
    margin-top: 0.5rem;
  }
</style>
